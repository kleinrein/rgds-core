<!-- Original RGDS shader; same license as the RGDS project. Six texture samples. -->
// Original RGDS GLES2 preset: the original Game Boy's dot-matrix LCD. Its
// pixels sit on a lighter backing, so the gaps between them read as a light
// grid (most of all on dark areas), and each dark pixel casts a faint shadow
// down and to the right, as the liquid crystal floats above the reflector.
// Colour is not changed: a Game Boy game's palette (Graphics > Screen colours)
// gives the four shades their colours before this pass. RG DS Play draws Game
// Boy games with their own 160x144 grid in place of the DS's.
<vertex>
attribute vec2 a_vertex_coordinate;
attribute vec2 a_texture_coordinate;
varying vec2 v_texture_coordinate;
void main(){v_texture_coordinate=a_texture_coordinate;gl_Position=vec4(a_vertex_coordinate,0.0,1.0);}
</vertex>
<fragment>
uniform sampler2D u_texture;
uniform vec4 u_texture_size;
uniform vec2 u_target_size;
varying vec2 v_texture_coordinate;
float luma(vec3 c){return dot(c,vec3(0.299,0.587,0.114));}
void main(){
    vec2 cells=vec2(256.0,192.0),one=1.0/cells;
    vec2 at=v_texture_coordinate*cells,f=fract(at),uv=(floor(at)+0.5)*one;
    vec4 pixel=texture2D(u_texture,uv);
    vec3 c=pixel.rgb;
    // The backing seen through the gaps: the lightest neighbour, so a dark
    // pixel on a light screen is ringed by that light, and a dark area still
    // shows a grid a little lighter than itself. On light areas the gaps and
    // the pixels are the same colour, as on the handheld.
    vec3 paper=max(max(texture2D(u_texture,uv+vec2(one.x,0.0)).rgb,texture2D(u_texture,uv-vec2(one.x,0.0)).rgb),
                   max(texture2D(u_texture,uv+vec2(0.0,one.y)).rgb,texture2D(u_texture,uv-vec2(0.0,one.y)).rgb));
    vec3 gap=mix(c,max(c,paper),0.6);
    gap=min(mix(gap,gap*1.3+0.04,smoothstep(0.7,0.15,luma(c))),vec3(1.0));
    vec2 w=min(cells/max(u_target_size,vec2(1.0)),vec2(1.0));
    float strength=clamp(1.0/max(w.x,w.y)-1.0,0.0,1.0);
    vec2 edge=clamp((min(f,1.0-f)-0.07)/w+0.5,0.0,1.0);
    vec3 lit=mix(c,mix(gap,c,edge.x*edge.y),strength);
    // The shadow: the picture a third of a pixel up and to the left, where it is darker.
    vec3 s=texture2D(u_texture,v_texture_coordinate-one*0.4).rgb;
    lit*=1.0-0.4*clamp(luma(c)-luma(s),0.0,1.0)*(0.4+0.6*strength);
    pixel.rgb=clamp(lit,0.0,1.0);
    gl_FragColor=pixel;
}
</fragment>
