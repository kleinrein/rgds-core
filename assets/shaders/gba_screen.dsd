<!-- Original RGDS shader; same license as the RGDS project. One texture sample. -->
// Original RGDS GLES2 preset: the Game Boy Advance screen. Its LCD colour (as
// in gba_color.dsd, after Pokefan531's public-domain GBA model) and the faint
// gaps between its pixels, one cell per game pixel. RG DS Play draws GBA and
// Game Boy games with their own grid (240x160, 160x144) in place of the DS's.
<vertex>
attribute vec2 a_vertex_coordinate;
attribute vec2 a_texture_coordinate;
varying vec2 v_texture_coordinate;
void main(){v_texture_coordinate=a_texture_coordinate;gl_Position=vec4(a_vertex_coordinate,0.0,1.0);}
</vertex>
<fragment>
uniform sampler2D u_texture;
uniform vec4 u_texture_size;
uniform vec2 u_target_size;
varying vec2 v_texture_coordinate;
void main(){
    vec4 pixel=texture2D(u_texture,v_texture_coordinate);
    vec3 c=clamp(pow(pixel.rgb,vec3(2.7))*0.94,0.0,1.0);
    c=mat3(0.82,0.125,0.195, 0.24,0.665,0.075, -0.06,0.21,0.73)*c;
    c=pow(max(c,0.0),vec3(1.0/2.2));
    vec2 cells=vec2(256.0,192.0),f=fract(v_texture_coordinate*cells);
    vec2 w=min(cells/max(u_target_size,vec2(1.0)),vec2(1.0));
    float strength=clamp(1.0/max(w.x,w.y)-1.0,0.0,1.0);
    vec2 edge=clamp((min(f,1.0-f)-0.05)/w+0.5,0.0,1.0);
    c*=mix(1.0,mix(0.80,1.0,edge.x*edge.y)*1.04,strength);
    pixel.rgb=clamp(c,0.0,1.0);
    gl_FragColor=pixel;
}
</fragment>
