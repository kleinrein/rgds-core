<!-- Original RGDS shader; same license as the RGDS project. Four texture samples. -->
// Original RGDS GLES2 preset: natural DS colour with soft, rounded pixels whose
// light spills a little into the gaps between them.
<vertex>
attribute vec2 a_vertex_coordinate;
attribute vec2 a_texture_coordinate;
varying vec2 v_texture_coordinate;
void main(){v_texture_coordinate=a_texture_coordinate;gl_Position=vec4(a_vertex_coordinate,0.0,1.0);}
</vertex>
<fragment>
uniform sampler2D u_texture;
uniform vec4 u_texture_size;
uniform vec2 u_target_size;
varying vec2 v_texture_coordinate;
vec3 natural(vec3 c){
    c=pow(c,vec3(2.2));
    c=mat3(0.88,0.07,0.04, 0.09,0.86,0.08, 0.03,0.07,0.88)*c;
    c=pow(max(c,0.0),vec3(1.0/2.3));
    return mix(vec3(0.03,0.03,0.04),vec3(0.97,0.97,0.98),c);
}
void main(){
    vec2 cells=vec2(256.0,192.0),p=v_texture_coordinate*cells,cell=floor(p),f=p-cell;
    vec2 side=sign(f-0.5);
    vec4 pixel=texture2D(u_texture,(cell+0.5)/cells);vec3 center=pixel.rgb;
    vec3 across=texture2D(u_texture,(cell+0.5+vec2(side.x,0.0))/cells).rgb;
    vec3 down=texture2D(u_texture,(cell+0.5+vec2(0.0,side.y))/cells).rgb;
    vec3 corner=texture2D(u_texture,(cell+0.5+side)/cells).rgb;
    vec2 w=min(cells/max(u_target_size,vec2(1.0)),vec2(1.0));
    float strength=clamp(1.0/max(w.x,w.y)-1.0,0.0,1.0);
    // Light from the neighbours reaches only the outer part of each pixel.
    vec2 reach=smoothstep(vec2(0.30),0.5+0.5*w,abs(f-0.5))*0.5;
    vec3 spill=mix(mix(center,across,reach.x),mix(down,corner,reach.x),reach.y);
    // Rounded pixel shape with an anti-aliased edge.
    vec2 d=max(abs(f-0.5)-0.24,0.0);
    float shape=clamp((0.22-length(d))/max(w.x,w.y)+0.5,0.0,1.0);
    vec3 glow=0.5*(across+down)*0.18;
    vec3 c=mix(spill*0.78+glow,spill,shape);
    c=mix(center,c*1.06,strength);
    pixel.rgb=clamp(natural(c),0.0,1.0);
    gl_FragColor=pixel;
}
</fragment>
