<!-- Original RGDS shader; same license as the RGDS project. Five texture samples. -->
// Original RGDS GLES2 preset: bold colour with smoothed pixel-art edges.
// Staircase corners that two matching neighbours agree on are cut along the
// diagonal, then anti-aliased for the screen's scale. Flat areas stay crisp.
<vertex>
attribute vec2 a_vertex_coordinate;
attribute vec2 a_texture_coordinate;
varying vec2 v_texture_coordinate;
void main(){v_texture_coordinate=a_texture_coordinate;gl_Position=vec4(a_vertex_coordinate,0.0,1.0);}
</vertex>
<fragment>
uniform sampler2D u_texture;
uniform vec4 u_texture_size;
uniform vec2 u_target_size;
varying vec2 v_texture_coordinate;
vec3 tone(vec3 c){
    float l=dot(c,vec3(0.2126,0.7152,0.0722));
    float chroma=max(c.r,max(c.g,c.b))-min(c.r,min(c.g,c.b));
    c=clamp(mix(vec3(l),c,1.15+0.30*(1.0-chroma)),0.0,1.0);
    return mix(c,c*c*(3.0-2.0*c),0.45);
}
float same(vec3 a,vec3 b){return step(dot(abs(a-b),vec3(1.0)),0.12);}
void main(){
    vec2 cells=vec2(256.0,192.0),p=v_texture_coordinate*cells,cell=floor(p),f=p-cell;
    vec2 side=sign(f-0.5);
    vec4 pixel=texture2D(u_texture,(cell+0.5)/cells);vec3 center=pixel.rgb;
    vec3 across=texture2D(u_texture,(cell+0.5+vec2(side.x,0.0))/cells).rgb;
    vec3 down=texture2D(u_texture,(cell+0.5+vec2(0.0,side.y))/cells).rgb;
    vec3 away_x=texture2D(u_texture,(cell+0.5-vec2(side.x,0.0))/cells).rgb;
    vec3 away_y=texture2D(u_texture,(cell+0.5-vec2(0.0,side.y))/cells).rgb;
    // Round this corner only where the two neighbours form one edge and the
    // pixel is not part of a one-pixel line running through it.
    float corner=same(across,down)*(1.0-same(across,center))*(1.0-same(across,away_x))*(1.0-same(down,away_y));
    vec2 w=min(cells/max(u_target_size,vec2(1.0)),vec2(1.0));
    vec2 d=abs(f-0.5);
    float cut=clamp((d.x+d.y-0.5)/(w.x+w.y)+0.5,0.0,1.0)*corner;
    pixel.rgb=clamp(tone(mix(center,across,cut)),0.0,1.0);
    gl_FragColor=pixel;
}
</fragment>
