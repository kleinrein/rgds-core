&touch0 {
	/delete-property/ panel;
};

&touch1 {
	/delete-property/ panel;
};

/*
 * Display clocks: each video port on its own PLL at 126.4 MHz (VOP0 on HPLL, VOP1 on VPLL) instead of both on VPLL
 * at 292.5 MHz. Two panels sharing one PLL whose rate neither can divide exactly is the likely cause of the blanking
 * on touch seen with the mainline tree under Armbian (docs/OWN_OS_PLAN.md, hypotheses).
 */
&cru {
	assigned-clocks = <&pmucru CLK_RTC_32K>, <&cru PLL_GPLL>,
			  <&pmucru PLL_PPLL>, <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
	assigned-clock-rates = <32768>, <1200000000>,
			       <200000000>, <126400000>, <126400000>;
};

&vop {
	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
};

/*
 * Speaker amplifiers: the AW87391 driver RG DS OS carries (linux-patches/2-linux-0026), which names its controls
 * "Left AMP"/"Right AMP" and its supply vcc. The amps' regulator keeps ROCKNIX's name and pin group name.
 */
/delete-node/ &aw87391_pa_l;
/delete-node/ &aw87391_pa_r;

&i2c2 {
	aw87391_pa_l: aw87391@58 {
			compatible = "aw,aw87391-left";
			reg = <0x58>;
			sound-name-prefix = "Left AMP";
			vcc-supply = <&vdd_amp>;
	};

	aw87391_pa_r: aw87391@5b {
			compatible = "aw,aw87391-right";
			reg = <0x5b>;
			sound-name-prefix = "Right AMP";
			vcc-supply = <&vdd_amp>;
	};
};

/ {
	sound {
		simple-audio-card,routing =
			"MICL", "Mic Jack",
			"Headphones", "HPOL",
			"Headphones", "HPOR",
			"Internal Speakers", "Left AMP OUT",
			"Internal Speakers", "Right AMP OUT",
			"Left AMP IN", "HPOL",
			"Right AMP IN", "HPOR";
	};
};

&vdd_amp {
	pinctrl-0 = <&vcc_amp_h>;
	regulator-name = "vcc_amp";
	/delete-property/ vin-supply;

	regulator-state-mem {
		regulator-off-in-suspend;
	};
};

&pinctrl {
	/delete-node/ vdd-amp;

	vcc-amp {
		vcc_amp_h: vcc-amp-h {
			rockchip,pins =
				<4 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

/*
 * Deep sleep (true sleep, 2026-10-31): BL31's sleep mode for the RK3568 (board/rgds/kernel/rockchip_pm_config.c),
 * the RK817 put to sleep with the SoC through its sleep pin, and vdd_logic off while asleep: ARMOFF_LOGOFF powers the
 * logic domain down, and the PMU domain lives on vdda0v9_pmu, as on the vendor's boards. The charging and status
 * LEDs keep their state through the sleep (the amber charge light, the dim red "asleep" light).
 */
/ {
	rockchip_suspend: rockchip-suspend {
		compatible = "rockchip,pm-rk3568";
		rockchip,sleep-debug-en = <0>;
		rockchip,sleep-mode-config = <
			(0
			| RKPM_SLP_ARMOFF_LOGOFF
			| RKPM_SLP_CENTER_OFF
			| RKPM_SLP_HW_PLLS_OFF
			| RKPM_SLP_PMUALIVE_32K
			| RKPM_SLP_OSC_DIS
			| RKPM_SLP_PMIC_LP
			| RKPM_SLP_32K_PVTM
			)
		>;
		rockchip,wakeup-config = <
			(0
			| RKPM_GPIO_WKUP_EN
			)
		>;
	};
};

&rk817 {
	pinctrl-0 = <&i2s1m0_mclk &pmic_int_l &pmic_pins>;
};

&vdd_logic {
	regulator-state-mem {
		/delete-property/ regulator-on-in-suspend;
		/delete-property/ regulator-suspend-microvolt;
		regulator-off-in-suspend;
	};
};

&amber_led {
	retain-state-suspended;
};

&red_led {
	retain-state-suspended;
};

/* The lid's hall sensor line pulled up, as ROCKNIX's tree has it. */
&hall_int_l {
	rockchip,pins =
		<0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>;
};

/* The USB 1.1 host controller stays off: the port's USB 2.0 host covers keyboards, pads and storage. */
&usb_host0_ohci {
	status = "disabled";
};

/* Kernel crash records kept in RAM through a restart (rcS moves them to the card): pstore, CONFIG_PSTORE_RAM. */
/ {
	reserved-memory {
		ramoops@110000 {
			compatible = "ramoops";
			reg = <0x0 0x110000 0x0 0xf0000>;
			record-size = <0x20000>;
			console-size = <0x80000>;
			pmsg-size = <0x50000>;
		};
	};
};
