# RG DS OS's card: U-Boot where the RK3568's boot ROM looks for it (32K), a FAT boot partition (each slot's kernel and
# device tree in a/ and b/, extlinux.conf naming the one to boot), two read-only root slots (squashfs; b empty until
# the first update) and the data partition (exFAT, the rest of the card), made on the first boot.
image @BOOTVFAT@ {
	vfat {
		label = "RGDS-BOOT"
		file a/Image.lz4 { image = "Image.lz4" }
@DTBFILES@
		file extlinux/extlinux.conf { image = "@EXTLINUX@" }
		file bootcount { image = "bootcount" }
	}
	# two kernels (about 10 MiB each, LZ4) and room to replace one
	size = 128M
}

image @IMAGE@ {
	hdimage {
		partition-table-type = "gpt"
	}
	partition u-boot {
		in-partition-table = false
		image = "u-boot-rockchip.bin"
		offset = 32K
	}
	partition boot {
		partition-type-uuid = "EBD0A0A2-B9E5-4433-87C0-68B6B72699C7"
		bootable = true
		image = "@BOOTVFAT@"
		offset = 16M
	}
	partition rgds-root-a {
		partition-type-uuid = "0FC63DAF-8483-4772-8E79-3D69D8477DE4"
		image = "rootfs.squashfs"
		size = 768M
	}
	partition rgds-root-b {
		partition-type-uuid = "0FC63DAF-8483-4772-8E79-3D69D8477DE4"
		size = 768M
	}
}
