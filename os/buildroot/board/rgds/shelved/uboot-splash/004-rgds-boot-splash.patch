diff --git a/drivers/video/rockchip/rk3568_vop2.c b/drivers/video/rockchip/rk3568_vop2.c
new file mode 100644
index 0000000..e3a4eeb
--- /dev/null
+++ b/drivers/video/rockchip/rk3568_vop2.c
@@ -0,0 +1,438 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * RG DS OS: a minimal RK3566/RK3568 VOP2 driver for the boot splash. Each DSI host (dw_mipi_dsi_rockchip.c) gets
+ * a video port: dsi0 (the RG DS's bottom screen) on VP0 through MIPI0, dsi1 (the top screen) on VP1 through
+ * MIPI1. Each port shows one Esmart window (Esmart0, Esmart1) over the one frame buffer, so both screens show the
+ * same picture, the port's background colour around it. The register sequence follows the kernel's
+ * rockchip_drm_vop2.c (vop2_crtc_atomic_enable, rk3568_set_intf_mux, vop2_post_config,
+ * rk3568_vop2_setup_layer_mixer, vop2_plane_atomic_update); a single layer on a port needs no alpha set-up.
+ *
+ * The display is brought up only by the rgds_splash command (bootcmd), not at stdio start-up, so the command can
+ * keep a fail-safe on the boot partition first: /splash.log is "try" while the display is set up, then the result
+ * ("lit ..." or the step that failed); Linux prefixes it with "ok" once it has booted. A log still at "try" or
+ * "lit" means the last splash did not get as far as Linux, and the splash is skipped. /splash-off turns it off.
+ * The picture is /splash.bmp (an 8-bit BMP, the kernel's boot logo; board/rgds/ppm2bmp.py).
+ */
+#include <bootstage.h>
+#include <clk.h>
+#include <command.h>
+#include <cpu_func.h>
+#include <dm.h>
+#include <fs.h>
+#include <malloc.h>
+#include <mapmem.h>
+#include <panel.h>
+#include <time.h>
+#include <video.h>
+#include <video_bridge.h>
+#include <asm/io.h>
+#include <dm/device-internal.h>
+#include <dm/device_compat.h>
+#include <dm/uclass-internal.h>
+#include <linux/bitfield.h>
+#include <linux/bitops.h>
+
+#define RK3568_REG_CFG_DONE			0x000
+#define RK3568_VERSION_INFO			0x004
+#define RK3568_SYS_AUTO_GATING_CTRL		0x008
+#define RK3568_DSP_IF_EN			0x028
+#define RK3568_DSP_IF_POL			0x030
+#define RK3568_OVL_CTRL				0x600
+#define RK3568_OVL_LAYER_SEL			0x604
+#define RK3568_OVL_PORT_SEL			0x608
+#define RK3568_VP_BG_MIX_CTRL(vp)		(0x6e0 + (vp) * 4)
+
+#define RK3568_VP(vp)				(0xc00 + (vp) * 0x100)
+#define RK3568_VP_DSP_CTRL			0x00
+#define RK3568_VP_MIPI_CTRL			0x04
+#define RK3568_VP_DSP_BG			0x2c
+#define RK3568_VP_PRE_SCAN_HTIMING		0x30
+#define RK3568_VP_POST_DSP_HACT_INFO		0x34
+#define RK3568_VP_POST_DSP_VACT_INFO		0x38
+#define RK3568_VP_POST_SCL_FACTOR_YRGB		0x3c
+#define RK3568_VP_POST_SCL_CTRL			0x40
+#define RK3568_VP_DSP_HTOTAL_HS_END		0x48
+#define RK3568_VP_DSP_HACT_ST_END		0x4c
+#define RK3568_VP_DSP_VTOTAL_VS_END		0x50
+#define RK3568_VP_DSP_VACT_ST_END		0x54
+
+/* Esmart0 (0x1800) for VP0, Esmart1 (0x1a00) for VP1 */
+#define RK3568_ESMART(vp)			(0x1800 + (vp) * 0x200)
+#define RK3568_SMART_CTRL0			0x00
+#define RK3568_SMART_REGION0_CTRL		0x10
+#define RK3568_SMART_REGION0_YRGB_MST		0x14
+#define RK3568_SMART_REGION0_VIR		0x1c
+#define RK3568_SMART_REGION0_ACT_INFO		0x20
+#define RK3568_SMART_REGION0_DSP_INFO		0x24
+#define RK3568_SMART_REGION0_DSP_ST		0x28
+#define RK3568_SMART_REGION0_SCL_CTRL		0x30
+
+#define RK3568_REG_CFG_DONE__GLB_CFG_DONE_EN	BIT(15)
+#define RK3568_SYS_AUTO_GATING_CTRL__AUTO_GATING_EN BIT(31)
+#define RK3568_SYS_DSP_INFACE_EN_MIPI0		BIT(4)
+#define RK3568_SYS_DSP_INFACE_EN_MIPI0_MUX	GENMASK(17, 16)
+#define RK3568_SYS_DSP_INFACE_EN_MIPI1		BIT(20)
+#define RK3568_SYS_DSP_INFACE_EN_MIPI1_MUX	GENMASK(22, 21)
+#define RK3568_DSP_IF_POL__MIPI_PIN_POL		GENMASK(19, 16)
+#define RK3568_DSP_IF_POL__CFG_DONE_IMD		BIT(28)
+#define RK3568_OVL_CTRL__LAYERSEL_REGDONE_SEL	GENMASK(31, 30)
+#define RK3568_OVL_CTRL__LAYERSEL_REGDONE_IMD	BIT(28)
+#define RK3568_OVL_CTRL__YUV_MODE(vp)		BIT(vp)
+/* the kernel's pre_scan_max_dly[3] for VP0 and VP1 */
+static const u8 rk3568_vp_bg_dly[] = { 42, 40 };
+
+/*
+ * Overlay: layer 0 is Esmart0 (layer_sel_id 2) for VP0, layer 1 Esmart1 (6) for VP1; the other windows fill
+ * layers 2-5 on VP2, which has no output (port mux 8). Port sel: each window's port in the high half
+ * (Cluster0/1 [19:16] and Smart0/1 [31:28] on VP2, Esmart0 [25:24] VP0, Esmart1 [27:26] VP1), each port's last
+ * layer in the low half.
+ */
+#define RGDS_OVL_LAYER_SEL			(2 | 6 << 4 | 0 << 8 | 1 << 12 | 3 << 16 | 7 << 20)
+#define RGDS_OVL_PORT_SEL			(2 << 16 | 2 << 18 | 0 << 24 | 1 << 26 | 2 << 28 | 2 << 30 | \
+						 8 << 8 | 1 << 4 | 0)
+
+/* the kernel logo's background (board/rgds/boot-logo.ppm) */
+#define RGDS_SPLASH_RGB				0xf2f5f7
+#define RGDS_SPLASH_DEV				"1:1"
+#define RGDS_SPLASH_BMP_MAX			(512 * 1024)
+
+struct rk3568_vop2_port {
+	struct udevice *bridge;
+	struct udevice *panel;
+	struct display_timing timing;
+};
+
+struct rk3568_vop2_priv {
+	void __iomem *regs;
+	struct clk aclk;
+	struct clk hclk;
+	struct rk3568_vop2_port port[2];
+};
+
+static bool rgds_splash_armed;
+static char rgds_splash_status[160];
+
+static void vop2_write(struct rk3568_vop2_priv *vop2, u32 reg, u32 val)
+{
+	writel(val, vop2->regs + reg);
+}
+
+static void vp_write(struct rk3568_vop2_priv *vop2, int vp, u32 reg, u32 val)
+{
+	writel(val, vop2->regs + RK3568_VP(vp) + reg);
+}
+
+static void win_write(struct rk3568_vop2_priv *vop2, int vp, u32 reg, u32 val)
+{
+	writel(val, vop2->regs + RK3568_ESMART(vp) + reg);
+}
+
+static void vop2_cfg_done(struct rk3568_vop2_priv *vop2, int vp)
+{
+	setbits_le32(vop2->regs + RK3568_REG_CFG_DONE,
+		     RK3568_REG_CFG_DONE__GLB_CFG_DONE_EN | BIT(vp) | BIT(vp) << 16);
+}
+
+static u32 vop2_bg(u32 rgb)
+{
+	u32 r = (rgb >> 16) & 0xff, g = (rgb >> 8) & 0xff, b = rgb & 0xff;
+
+	/* 10 bits a channel */
+	return (r << 2 | r >> 6) << 20 | (g << 2 | g >> 6) << 10 | (b << 2 | b >> 6);
+}
+
+static void vop2_mode_set(struct rk3568_vop2_priv *vop2, int vp, const struct display_timing *t)
+{
+	u32 hdisplay = t->hactive.typ, vdisplay = t->vactive.typ;
+	u32 hsync_len = t->hsync_len.typ, vsync_len = t->vsync_len.typ;
+	u32 htotal = hdisplay + t->hfront_porch.typ + hsync_len + t->hback_porch.typ;
+	u32 vtotal = vdisplay + t->vfront_porch.typ + vsync_len + t->vback_porch.typ;
+	u32 hact_st = hsync_len + t->hback_porch.typ, hact_end = hact_st + hdisplay;
+	u32 vact_st = vsync_len + t->vback_porch.typ, vact_end = vact_st + vdisplay;
+	u32 die, dip;
+
+	/* MIPI0 from VP0 or MIPI1 from VP1, negative syncs (polarity bits clear) */
+	die = readl(vop2->regs + RK3568_DSP_IF_EN);
+	if (vp == 0) {
+		die &= ~RK3568_SYS_DSP_INFACE_EN_MIPI0_MUX;
+		die |= RK3568_SYS_DSP_INFACE_EN_MIPI0;
+	} else {
+		die &= ~RK3568_SYS_DSP_INFACE_EN_MIPI1_MUX;
+		die |= RK3568_SYS_DSP_INFACE_EN_MIPI1 | FIELD_PREP(RK3568_SYS_DSP_INFACE_EN_MIPI1_MUX, vp);
+	}
+	dip = readl(vop2->regs + RK3568_DSP_IF_POL);
+	dip &= ~RK3568_DSP_IF_POL__MIPI_PIN_POL;
+	dip |= RK3568_DSP_IF_POL__CFG_DONE_IMD;
+	vop2_write(vop2, RK3568_DSP_IF_EN, die);
+	vop2_write(vop2, RK3568_DSP_IF_POL, dip);
+
+	vp_write(vop2, vp, RK3568_VP_DSP_HTOTAL_HS_END, htotal << 16 | hsync_len);
+	vp_write(vop2, vp, RK3568_VP_DSP_HACT_ST_END, hact_st << 16 | hact_end);
+	vp_write(vop2, vp, RK3568_VP_DSP_VACT_ST_END, vact_st << 16 | vact_end);
+	vp_write(vop2, vp, RK3568_VP_DSP_VTOTAL_VS_END, vtotal << 16 | vsync_len);
+	vp_write(vop2, vp, RK3568_VP_MIPI_CTRL, 0);
+
+	/* post config without margins or scaling */
+	vop2_write(vop2, RK3568_VP_BG_MIX_CTRL(vp), rk3568_vp_bg_dly[vp] << 24);
+	vp_write(vop2, vp, RK3568_VP_PRE_SCAN_HTIMING, (rk3568_vp_bg_dly[vp] + (hdisplay >> 1) - 1) << 16 | hsync_len);
+	vp_write(vop2, vp, RK3568_VP_POST_DSP_HACT_INFO, hact_st << 16 | hact_end);
+	vp_write(vop2, vp, RK3568_VP_POST_DSP_VACT_INFO, vact_st << 16 | vact_end);
+	vp_write(vop2, vp, RK3568_VP_POST_SCL_FACTOR_YRGB, 0x1000 << 16 | 0x1000);
+	vp_write(vop2, vp, RK3568_VP_POST_SCL_CTRL, 0);
+	vp_write(vop2, vp, RK3568_VP_DSP_BG, vop2_bg(RGDS_SPLASH_RGB));
+	vop2_cfg_done(vop2, vp);
+
+	/* out of standby, RGB888 out (ROCKCHIP_OUT_MODE_P888) */
+	vp_write(vop2, vp, RK3568_VP_DSP_CTRL, 0);
+	vop2_cfg_done(vop2, vp);
+}
+
+/* the port's Esmart window over the frame buffer (XRGB8888), centred */
+static void vop2_window_set(struct rk3568_vop2_priv *vop2, int vp, ulong fb, u32 width, u32 height)
+{
+	const struct display_timing *t = &vop2->port[vp].timing;
+	u32 w = min(width, t->hactive.typ), h = min(height, t->vactive.typ);
+	u32 x = (t->hactive.typ - w) / 2 + t->hsync_len.typ + t->hback_porch.typ;
+	u32 y = (t->vactive.typ - h) / 2 + t->vsync_len.typ + t->vback_porch.typ;
+
+	win_write(vop2, vp, RK3568_SMART_CTRL0, 0);
+	win_write(vop2, vp, RK3568_SMART_REGION0_YRGB_MST, (u32)fb);
+	win_write(vop2, vp, RK3568_SMART_REGION0_VIR, width);
+	win_write(vop2, vp, RK3568_SMART_REGION0_ACT_INFO, (h - 1) << 16 | (w - 1));
+	win_write(vop2, vp, RK3568_SMART_REGION0_DSP_INFO, (h - 1) << 16 | (w - 1));
+	win_write(vop2, vp, RK3568_SMART_REGION0_DSP_ST, y << 16 | x);
+	win_write(vop2, vp, RK3568_SMART_REGION0_SCL_CTRL, 0);
+	/* enable, format 0 (VOP2_FMT_ARGB8888, which XRGB8888 uses), no R/B swap */
+	win_write(vop2, vp, RK3568_SMART_REGION0_CTRL, BIT(0));
+}
+
+#define fail(step, ret) ({ \
+	snprintf(rgds_splash_status, sizeof(rgds_splash_status), "fail %s %d\n", step, ret); \
+	ret; })
+
+/* the port a DSI host feeds: dsi0 (0xfe060000) VP0, dsi1 (0xfe070000) VP1 */
+static int rk3568_vop2_port_of(struct udevice *bridge)
+{
+	fdt_addr_t reg = dev_read_addr(bridge);
+
+	return reg == 0xfe060000 ? 0 : reg == 0xfe070000 ? 1 : -1;
+}
+
+/*
+ * Panels powered and through their init sequence, ports running with the background colour, DSI hosts in video
+ * mode; the windows and the backlights wait for rk3568_vop2_show(), once the picture is in the frame buffer.
+ */
+static int rk3568_vop2_probe(struct udevice *dev)
+{
+	struct video_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct rk3568_vop2_priv *vop2 = dev_get_priv(dev);
+	struct udevice *bridge;
+	char name[12];
+	int vp, ret, lit = 0;
+	u32 ovl;
+
+	/* only from the rgds_splash command, see above */
+	if (!rgds_splash_armed)
+		return -EAGAIN;
+
+	vop2->regs = dev_read_addr_index_ptr(dev, 0);
+	if (!vop2->regs)
+		return fail("regs", -EINVAL);
+	ret = clk_get_by_name(dev, "aclk", &vop2->aclk);
+	if (!ret)
+		ret = clk_get_by_name(dev, "hclk", &vop2->hclk);
+	if (ret)
+		return fail("clocks", ret);
+	clk_enable(&vop2->aclk);
+	clk_enable(&vop2->hclk);
+
+	/*
+	 * Each panel's probe powers it and releases reset; probing both first lets their init delays run together,
+	 * while the ports are set up.
+	 */
+	for (uclass_find_first_device(UCLASS_VIDEO_BRIDGE, &bridge); bridge;
+	     uclass_find_next_device(&bridge)) {
+		vp = rk3568_vop2_port_of(bridge);
+		if (vp < 0)
+			continue;
+		ret = device_probe(bridge);
+		if (!ret)
+			ret = device_find_first_child_by_uclass(bridge, UCLASS_PANEL, &vop2->port[vp].panel);
+		if (!ret)
+			ret = device_probe(vop2->port[vp].panel);
+		if (!ret)
+			ret = panel_get_display_timing(vop2->port[vp].panel, &vop2->port[vp].timing);
+		if (ret)
+			return fail(vp ? "panel1" : "panel0", ret);
+		vop2->port[vp].bridge = bridge;
+	}
+
+	vop2_write(vop2, RK3568_REG_CFG_DONE, RK3568_REG_CFG_DONE__GLB_CFG_DONE_EN);
+	clrbits_le32(vop2->regs + RK3568_SYS_AUTO_GATING_CTRL, RK3568_SYS_AUTO_GATING_CTRL__AUTO_GATING_EN);
+	ovl = readl(vop2->regs + RK3568_OVL_CTRL);
+	ovl &= ~(RK3568_OVL_CTRL__LAYERSEL_REGDONE_IMD | RK3568_OVL_CTRL__LAYERSEL_REGDONE_SEL |
+		 RK3568_OVL_CTRL__YUV_MODE(0) | RK3568_OVL_CTRL__YUV_MODE(1));
+	vop2_write(vop2, RK3568_OVL_CTRL, ovl);
+	vop2_write(vop2, RK3568_OVL_LAYER_SEL, RGDS_OVL_LAYER_SEL);
+	vop2_write(vop2, RK3568_OVL_PORT_SEL, RGDS_OVL_PORT_SEL);
+
+	for (vp = 0; vp < 2; vp++) {
+		struct rk3568_vop2_port *port = &vop2->port[vp];
+		struct clk dclk;
+		ulong rate;
+
+		if (!port->bridge)
+			continue;
+		snprintf(name, sizeof(name), "dclk_vp%d", vp);
+		ret = clk_get_by_name(dev, name, &dclk);
+		if (ret)
+			return fail(name, ret);
+		clk_enable(&dclk);
+		rate = clk_set_rate(&dclk, port->timing.pixelclock.typ);
+		if (IS_ERR_VALUE(rate))
+			return fail(name, (int)rate);
+		vop2_mode_set(vop2, vp, &port->timing);
+		ret = video_bridge_attach(port->bridge);
+		if (ret)
+			return fail(vp ? "attach1" : "attach0", ret);
+		/* the panel's init sequence and sleep out (no backlight yet), then the DSI host's video mode */
+		ret = video_bridge_set_backlight(port->bridge, 0);
+		if (ret)
+			return fail(vp ? "enable1" : "enable0", ret);
+		lit++;
+	}
+	if (!lit)
+		return fail("no-dsi", -ENODEV);
+
+	uc_priv->xsize = vop2->port[vop2->port[0].bridge ? 0 : 1].timing.hactive.typ;
+	uc_priv->ysize = vop2->port[vop2->port[0].bridge ? 0 : 1].timing.vactive.typ;
+	uc_priv->bpix = VIDEO_BPP32;
+	uc_priv->format = VIDEO_X8R8G8B8;
+	video_set_flush_dcache(dev, true);
+
+	return 0;
+}
+
+/* the windows over the frame buffer (when there is a picture), then the backlights at the panels' delay */
+static void rk3568_vop2_show(struct udevice *dev, bool picture)
+{
+	struct video_uc_plat *plat = dev_get_uclass_plat(dev);
+	struct video_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct rk3568_vop2_priv *vop2 = dev_get_priv(dev);
+	int vp;
+
+	for (vp = 0; vp < 2; vp++) {
+		if (!vop2->port[vp].bridge)
+			continue;
+		if (picture) {
+			vop2_window_set(vop2, vp, plat->base, uc_priv->xsize, uc_priv->ysize);
+			vop2_cfg_done(vop2, vp);
+		}
+	}
+	for (vp = 0; vp < 2; vp++)
+		if (vop2->port[vp].bridge)
+			panel_set_backlight(vop2->port[vp].panel, 50);
+}
+
+static int rk3568_vop2_bind(struct udevice *dev)
+{
+	struct video_uc_plat *plat = dev_get_uclass_plat(dev);
+
+	/* one 640x480 XRGB8888 frame, the panels' size */
+	plat->size = 640 * 480 * 4;
+
+	return 0;
+}
+
+static const struct udevice_id rk3568_vop2_ids[] = {
+	{ .compatible = "rockchip,rk3566-vop" },
+	{ .compatible = "rockchip,rk3568-vop" },
+	{ }
+};
+
+U_BOOT_DRIVER(rk3568_vop2) = {
+	.name		= "rk3568_vop2",
+	.id		= UCLASS_VIDEO,
+	.of_match	= rk3568_vop2_ids,
+	.bind		= rk3568_vop2_bind,
+	.probe		= rk3568_vop2_probe,
+	.priv_auto	= sizeof(struct rk3568_vop2_priv),
+};
+
+static int rgds_splash_read(const char *name, void *buf, int size)
+{
+	loff_t len = 0;
+
+	if (fs_set_blk_dev("mmc", RGDS_SPLASH_DEV, FS_TYPE_FAT))
+		return -ENODEV;
+	if (fs_read(name, map_to_sysmem(buf), 0, size, &len))
+		return -ENOENT;
+	return len;
+}
+
+static int rgds_splash_write(const char *text)
+{
+	loff_t len;
+
+	if (fs_set_blk_dev("mmc", RGDS_SPLASH_DEV, FS_TYPE_FAT))
+		return -ENODEV;
+	return fs_write("/splash.log", map_to_sysmem(text), 0, strlen(text), &len);
+}
+
+static int do_rgds_splash(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	struct rk3568_vop2_priv *vop2;
+	struct udevice *dev;
+	char log[16] = "";
+	ulong start = get_timer(0);
+	void *bmp;
+	int len, ret;
+
+	bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "rgds_splash");
+	if (rgds_splash_read("/splash-off", log, sizeof(log) - 1) >= 0)
+		return CMD_RET_SUCCESS;
+	len = rgds_splash_read("/splash.log", log, sizeof(log) - 1);
+	if (len >= 0) {
+		log[len] = 0;
+		if (!strncmp(log, "try", 3) || !strncmp(log, "lit", 3)) {
+			printf("rgds_splash: the last splash did not reach Linux (%s), skipped\n", log);
+			return CMD_RET_SUCCESS;
+		}
+	}
+	if (rgds_splash_write("try\n"))
+		return CMD_RET_SUCCESS;
+
+	rgds_splash_armed = true;
+	strcpy(rgds_splash_status, "fail probe\n");
+	if (uclass_first_device_err(UCLASS_VIDEO, &dev)) {
+		rgds_splash_write(rgds_splash_status);
+		return CMD_RET_SUCCESS;
+	}
+	vop2 = dev_get_priv(dev);
+
+	/* the picture into the frame buffer before any window or backlight shows it */
+	ret = -ENOMEM;
+	bmp = malloc(RGDS_SPLASH_BMP_MAX);
+	if (bmp) {
+		ret = rgds_splash_read("/splash.bmp", bmp, RGDS_SPLASH_BMP_MAX);
+		if (ret > 0)
+			ret = video_bmp_display(dev, map_to_sysmem(bmp), 0, 0, false);
+		if (!ret)
+			ret = video_sync(dev, true);
+		free(bmp);
+	}
+	rk3568_vop2_show(dev, !ret);
+
+	snprintf(rgds_splash_status, sizeof(rgds_splash_status),
+		 "lit vp0=%s vp1=%s bmp=%d ms=%lu version=%08x\n", vop2->port[0].bridge ? "on" : "off",
+		 vop2->port[1].bridge ? "on" : "off", ret, get_timer(start),
+		 readl(vop2->regs + RK3568_VERSION_INFO));
+	rgds_splash_write(rgds_splash_status);
+	bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "rgds_splash_done");
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(rgds_splash, 1, 0, do_rgds_splash,
+	   "light the RG DS's panels with the boot logo",
+	   "");
