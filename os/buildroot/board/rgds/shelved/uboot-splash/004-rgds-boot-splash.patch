--- /dev/null
+++ b/drivers/video/panel-generic-dsi.c
@@ -0,0 +1,305 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * ROCKNIX's generic DSI panel (compatible "rocknix,generic-dsi") for U-Boot: the panel's globals, mode and DCS
+ * init sequence come from the device tree's panel_description strings, read the way the kernel's
+ * panel-generic-dsi.c reads them:
+ *
+ *   "G size=81,61 delays=20,10,50,120,50 format=rgb888 lanes=4 flags=0xc03"
+ *   "M clock=42134 horizontal=640,260,220,260 vertical=480,10,2,16 default=1"
+ *   "I seq=e000" ... ("I seq=<hex bytes> wait=<hex ms>", sent as one DCS write)
+ *
+ * delays are prepare, reset, init, enable (after sleep-out) and ready, in ms; horizontal and vertical are
+ * active, front porch, sync and back porch; clock is in kHz.
+ *
+ * RG DS OS: lights both panels for the boot splash (rk3568_vop2.c).
+ */
+#include <backlight.h>
+#include <dm.h>
+#include <malloc.h>
+#include <mipi_dsi.h>
+#include <panel.h>
+#include <time.h>
+#include <asm/gpio.h>
+#include <dm/device_compat.h>
+#include <linux/ctype.h>
+#include <linux/delay.h>
+#include <power/regulator.h>
+#include <vsprintf.h>
+
+#define GENERIC_DSI_MAX_SEQ	512
+
+struct generic_dsi_seq {
+	u8 len;
+	u8 wait;
+	u8 data[14];
+};
+
+struct generic_dsi_priv {
+	struct udevice *vdd;
+	struct udevice *iovcc;
+	struct udevice *backlight;
+	struct gpio_desc reset;
+	int delays[5];
+	struct display_timing timing;
+	struct generic_dsi_seq *seq;
+	int seq_count;
+	ulong reset_released;
+	ulong awake;
+};
+
+/* "a,b,c" into up to n ints; returns how many were read */
+static int generic_dsi_ints(const char *val, int *out, int n)
+{
+	int i = 0;
+
+	while (*val && i < n) {
+		out[i++] = simple_strtol(val, (char **)&val, 0);
+		if (*val != ',')
+			break;
+		val++;
+	}
+	return i;
+}
+
+static int generic_dsi_nibble(char c)
+{
+	return c <= '9' ? c - '0' : (c | 0x20) - 'a' + 10;
+}
+
+static int generic_dsi_hex(const char *val, u8 *out, int n)
+{
+	int len = 0;
+
+	while (isxdigit(val[0]) && isxdigit(val[1]) && len < n) {
+		out[len++] = generic_dsi_nibble(val[0]) << 4 | generic_dsi_nibble(val[1]);
+		val += 2;
+	}
+	return len;
+}
+
+static void generic_dsi_line(struct udevice *dev, const char *line)
+{
+	struct generic_dsi_priv *priv = dev_get_priv(dev);
+	struct mipi_dsi_panel_plat *plat = dev_get_plat(dev);
+	struct display_timing *t = &priv->timing;
+	struct generic_dsi_seq *seq = NULL;
+	char kind = line[0];
+	char word[64];
+	int v[4];
+
+	/* the first mode only; the RG DS has one */
+	if (kind == 'M' && t->pixelclock.typ)
+		return;
+	if (kind == 'I') {
+		if (priv->seq_count >= GENERIC_DSI_MAX_SEQ)
+			return;
+		seq = &priv->seq[priv->seq_count];
+		memset(seq, 0, sizeof(*seq));
+	}
+	for (line++; *line;) {
+		const char *val;
+		int n = 0;
+
+		while (*line == ' ')
+			line++;
+		while (line[n] && line[n] != ' ' && n < (int)sizeof(word) - 1)
+			n++;
+		memcpy(word, line, n);
+		word[n] = 0;
+		line += n;
+		val = strchr(word, '=');
+		if (!val)
+			continue;
+		val++;
+		if (kind == 'G') {
+			if (!strncmp(word, "delays=", 7))
+				generic_dsi_ints(val, priv->delays, 5);
+			else if (!strncmp(word, "lanes=", 6))
+				plat->lanes = simple_strtoul(val, NULL, 0);
+			else if (!strncmp(word, "flags=", 6))
+				plat->mode_flags = simple_strtoul(val, NULL, 0);
+			else if (!strncmp(word, "format=", 7))
+				plat->format = !strcmp(val, "rgb666") ? MIPI_DSI_FMT_RGB666 :
+					       !strcmp(val, "rgb565") ? MIPI_DSI_FMT_RGB565 : MIPI_DSI_FMT_RGB888;
+		} else if (kind == 'M') {
+			if (!strncmp(word, "clock=", 6)) {
+				t->pixelclock.typ = simple_strtoul(val, NULL, 0) * 1000;
+			} else if (!strncmp(word, "horizontal=", 11) && generic_dsi_ints(val, v, 4) == 4) {
+				t->hactive.typ = v[0];
+				t->hfront_porch.typ = v[1];
+				t->hsync_len.typ = v[2];
+				t->hback_porch.typ = v[3];
+			} else if (!strncmp(word, "vertical=", 9) && generic_dsi_ints(val, v, 4) == 4) {
+				t->vactive.typ = v[0];
+				t->vfront_porch.typ = v[1];
+				t->vsync_len.typ = v[2];
+				t->vback_porch.typ = v[3];
+			}
+		} else if (seq) {
+			if (!strncmp(word, "seq=", 4))
+				seq->len = generic_dsi_hex(val, seq->data, sizeof(seq->data));
+			else if (!strncmp(word, "wait=", 5))
+				seq->wait = hextoul(val, NULL);
+		}
+	}
+	if (seq && seq->len)
+		priv->seq_count++;
+}
+
+static int generic_dsi_of_to_plat(struct udevice *dev)
+{
+	struct generic_dsi_priv *priv = dev_get_priv(dev);
+	struct mipi_dsi_panel_plat *plat = dev_get_plat(dev);
+	int count, i, ret;
+
+	priv->delays[0] = 5;
+	priv->delays[1] = 1;
+	priv->delays[2] = 25;
+	priv->delays[3] = 120;
+	priv->delays[4] = 50;
+	plat->lanes = 4;
+	plat->format = MIPI_DSI_FMT_RGB888;
+	plat->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_MODE_LPM;
+
+	priv->seq = calloc(GENERIC_DSI_MAX_SEQ, sizeof(*priv->seq));
+	if (!priv->seq)
+		return -ENOMEM;
+	count = dev_read_string_count(dev, "panel_description");
+	for (i = 0; i < count; i++) {
+		const char *line;
+
+		if (!dev_read_string_index(dev, "panel_description", i, &line))
+			generic_dsi_line(dev, line);
+	}
+	if (!priv->timing.pixelclock.typ || !priv->timing.hactive.typ || !priv->timing.vactive.typ) {
+		dev_err(dev, "no mode in panel_description\n");
+		return -EINVAL;
+	}
+	/* the kernel driver always gives its modes negative syncs */
+	priv->timing.flags = DISPLAY_FLAGS_HSYNC_LOW | DISPLAY_FLAGS_VSYNC_LOW;
+
+	ret = device_get_supply_regulator(dev, "vdd-supply", &priv->vdd);
+	if (ret && ret != -ENOENT)
+		return ret;
+	ret = device_get_supply_regulator(dev, "iovcc-supply", &priv->iovcc);
+	if (ret && ret != -ENOENT)
+		return ret;
+	ret = gpio_request_by_name(dev, "reset-gpios", 0, &priv->reset, GPIOD_IS_OUT);
+	if (ret && ret != -ENOENT)
+		return ret;
+	ret = uclass_get_device_by_phandle(UCLASS_PANEL_BACKLIGHT, dev, "backlight", &priv->backlight);
+	if (ret)
+		priv->backlight = NULL;
+
+	return 0;
+}
+
+/* power and reset; the panel's init delay then runs while the DSI host is set up */
+static int generic_dsi_probe(struct udevice *dev)
+{
+	struct generic_dsi_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	if (priv->vdd) {
+		ret = regulator_set_enable(priv->vdd, true);
+		if (ret && ret != -EALREADY)
+			return ret;
+	}
+	if (priv->iovcc) {
+		ret = regulator_set_enable(priv->iovcc, true);
+		if (ret && ret != -EALREADY)
+			return ret;
+	}
+	mdelay(priv->delays[0]);
+	if (dm_gpio_is_valid(&priv->reset)) {
+		dm_gpio_set_value(&priv->reset, 1);
+		mdelay(priv->delays[1]);
+		dm_gpio_set_value(&priv->reset, 0);
+	}
+	priv->reset_released = get_timer(0);
+
+	return 0;
+}
+
+/*
+ * The DCS sequence, display on and sleep out (in the kernel driver's order). The backlight waits for
+ * set_backlight, which keeps the enable delay after sleep-out, so two panels share one wait.
+ */
+static int generic_dsi_enable_backlight(struct udevice *dev)
+{
+	struct generic_dsi_priv *priv = dev_get_priv(dev);
+	struct mipi_dsi_panel_plat *plat = dev_get_plat(dev);
+	struct mipi_dsi_device *device = plat->device;
+	ulong waited;
+	int i, ret;
+
+	ret = mipi_dsi_attach(device);
+	if (ret < 0)
+		return ret;
+
+	waited = get_timer(priv->reset_released);
+	if (waited < priv->delays[2])
+		mdelay(priv->delays[2] - waited);
+	for (i = 0; i < priv->seq_count; i++) {
+		ret = mipi_dsi_dcs_write_buffer(device, priv->seq[i].data, priv->seq[i].len);
+		if (ret < 0)
+			return ret;
+		if (priv->seq[i].wait)
+			mdelay(priv->seq[i].wait);
+	}
+	ret = mipi_dsi_dcs_set_display_on(device);
+	if (ret < 0)
+		return ret;
+	ret = mipi_dsi_dcs_exit_sleep_mode(device);
+	if (ret < 0)
+		return ret;
+	priv->awake = get_timer(0);
+
+	return 0;
+}
+
+static int generic_dsi_set_backlight(struct udevice *dev, int percent)
+{
+	struct generic_dsi_priv *priv = dev_get_priv(dev);
+	ulong waited = get_timer(priv->awake);
+	int ret;
+
+	if (waited < priv->delays[3])
+		mdelay(priv->delays[3] - waited);
+	if (!priv->backlight)
+		return 0;
+	ret = backlight_enable(priv->backlight);
+	if (ret)
+		return ret;
+	return backlight_set_brightness(priv->backlight, percent);
+}
+
+static int generic_dsi_get_display_timing(struct udevice *dev, struct display_timing *timing)
+{
+	struct generic_dsi_priv *priv = dev_get_priv(dev);
+
+	memcpy(timing, &priv->timing, sizeof(*timing));
+	return 0;
+}
+
+static const struct panel_ops generic_dsi_ops = {
+	.enable_backlight	= generic_dsi_enable_backlight,
+	.set_backlight		= generic_dsi_set_backlight,
+	.get_display_timing	= generic_dsi_get_display_timing,
+};
+
+static const struct udevice_id generic_dsi_ids[] = {
+	{ .compatible = "rocknix,generic-dsi" },
+	{ }
+};
+
+U_BOOT_DRIVER(generic_dsi_panel) = {
+	.name		= "generic_dsi_panel",
+	.id		= UCLASS_PANEL,
+	.of_match	= generic_dsi_ids,
+	.ops		= &generic_dsi_ops,
+	.of_to_plat	= generic_dsi_of_to_plat,
+	.probe		= generic_dsi_probe,
+	.plat_auto	= sizeof(struct mipi_dsi_panel_plat),
+	.priv_auto	= sizeof(struct generic_dsi_priv),
+};
