# straight to the kernel, no countdown, nothing on the panels
CONFIG_BOOTDELAY=0
CONFIG_AUTOBOOT=y
CONFIG_SILENT_CONSOLE=n
CONFIG_DISPLAY_BOARDINFO=n
CONFIG_DISPLAY_CPUINFO=n
# where U-Boot's time goes, read from /proc/device-tree/bootstage on the handheld (no UART needed)
CONFIG_BOOTSTAGE=y
CONFIG_BOOTSTAGE_FDT=y
CONFIG_BOOTSTAGE_RECORD_COUNT=64
# nothing but the card: no EFI, network, USB, PCI, NVMe or SCSI in the boot loader (each costs its init and a
# place in the bootflow scan; the bootstage table showed 2.4 s between U-Boot's prompt and bootm)
CONFIG_EFI_LOADER=n
CONFIG_CMD_BOOTEFI=n
CONFIG_BOOTMETH_EFILOADER=n
CONFIG_BOOTMETH_EFI_BOOTMGR=n
CONFIG_BOOTMETH_VBE=n
CONFIG_BOOTMETH_SCRIPT=n
CONFIG_BOOTMETH_EXTLINUX_PXE=n
CONFIG_CMD_PXE=n
# CONFIG_NET itself stays (board_r links eth_initialize); the board's ethernet driver and PHY go
CONFIG_CMD_NET=n
CONFIG_CMD_DHCP=n
CONFIG_DWC_ETH_QOS=n
CONFIG_DWC_ETH_QOS_ROCKCHIP=n
CONFIG_PHY_MOTORCOMM=n
CONFIG_PHY_ROCKCHIP_INNO_USB2=n
CONFIG_PHY_ROCKCHIP_NANENG_COMBOPHY=n
CONFIG_USB=n
CONFIG_CMD_USB=n
CONFIG_PCI=n
CONFIG_NVME_PCI=n
CONFIG_CMD_NVME=n
CONFIG_SCSI=n
CONFIG_SCSI_AHCI=n
CONFIG_AHCI=n
# the card at UHS speed (the kernel in 0.2 s rather than 1.4 s at the default 25 MHz)
CONFIG_MMC_UHS_SUPPORT=y
CONFIG_MMC_IO_VOLTAGE=y
# the RG DS has no SPI flash: no probe of one before relocation, no SPI boot in the SPL
CONFIG_SPI_FLASH=n
CONFIG_DM_SPI_FLASH=n
CONFIG_SPL_SPI_FLASH_SUPPORT=n
CONFIG_SPL_SPI=n
CONFIG_SPL_SPI_LOAD=n
CONFIG_ROCKCHIP_SPI_IMAGE=n
CONFIG_ROCKCHIP_SFC=n
# the card (mmc1 in this U-Boot's device tree) scanned first, the eMMC not brought up before it; the plain scan
# stays as the fallback should the label ever not resolve
CONFIG_BOOTCOMMAND="bootflow scan -lb mmc1 || bootflow scan -lb"
# only the SD card is a boot target: the RG DS's eMMC holds the factory Android and is never touched
CONFIG_ENV_IS_NOWHERE=y
CONFIG_ENV_IS_IN_MMC=n
