# straight to the kernel, no countdown, nothing on the panels
CONFIG_BOOTDELAY=0
CONFIG_AUTOBOOT=y
CONFIG_SILENT_CONSOLE=n
CONFIG_DISPLAY_BOARDINFO=n
CONFIG_DISPLAY_CPUINFO=n
# where U-Boot's time goes, read from /proc/device-tree/bootstage on the handheld (no UART needed)
CONFIG_BOOTSTAGE=y
CONFIG_BOOTSTAGE_FDT=y
CONFIG_BOOTSTAGE_RECORD_COUNT=64
# nothing but the card: no EFI, network, USB, PCI, NVMe or SCSI in the boot loader (each costs its init and a
# place in the bootflow scan; the bootstage table showed 2.4 s between U-Boot's prompt and bootm)
CONFIG_EFI_LOADER=n
CONFIG_CMD_BOOTEFI=n
CONFIG_BOOTMETH_EFILOADER=n
CONFIG_BOOTMETH_EFI_BOOTMGR=n
CONFIG_BOOTMETH_VBE=n
CONFIG_BOOTMETH_SCRIPT=n
CONFIG_BOOTMETH_EXTLINUX_PXE=n
CONFIG_CMD_PXE=n
# CONFIG_NET itself stays (board_r links eth_initialize); the board's ethernet driver and PHY go
CONFIG_CMD_NET=n
CONFIG_CMD_DHCP=n
CONFIG_DWC_ETH_QOS=n
CONFIG_DWC_ETH_QOS_ROCKCHIP=n
CONFIG_PHY_MOTORCOMM=n
CONFIG_PHY_ROCKCHIP_INNO_USB2=n
CONFIG_PHY_ROCKCHIP_NANENG_COMBOPHY=n
CONFIG_USB=n
CONFIG_CMD_USB=n
CONFIG_PCI=n
CONFIG_NVME_PCI=n
CONFIG_CMD_NVME=n
CONFIG_SCSI=n
CONFIG_SCSI_AHCI=n
CONFIG_AHCI=n
# the card at UHS speed (the kernel in 0.2 s rather than 1.4 s at the default 25 MHz)
CONFIG_MMC_UHS_SUPPORT=y
CONFIG_MMC_IO_VOLTAGE=y
# the RG DS has no SPI flash: no probe of one before relocation, no SPI boot in the SPL
CONFIG_SPI_FLASH=n
CONFIG_DM_SPI_FLASH=n
CONFIG_SPL_SPI_FLASH_SUPPORT=n
CONFIG_SPL_SPI=n
CONFIG_SPL_SPI_LOAD=n
CONFIG_ROCKCHIP_SPI_IMAGE=n
CONFIG_ROCKCHIP_SFC=n
# the card (mmc1 in this U-Boot's device tree) scanned first, the eMMC not brought up before it; the plain scan
# stays as the fallback should the label ever not resolve. (A boot splash from U-Boot was built and dropped: it cost
# 0.45 s for ~2 s of logo before the kernel resets the panels; board/rgds/shelved/uboot-splash, docs/OWN_OS_PLAN.md.)
CONFIG_BOOTCOMMAND="bootflow scan -lb mmc1 || bootflow scan -lb"
# only the SD card is a boot target: the RG DS's eMMC holds the factory Android and is never touched
CONFIG_ENV_IS_NOWHERE=y
CONFIG_ENV_IS_IN_MMC=n
# A/B fallback: the boot counter lives in /bootcount on the FAT boot partition (4 bytes: magic bd, version 1,
# count, upgrade-in-progress). It only counts while an update is in progress (the handheld arms it when it
# switches slots, usr/libexec/rgds/trial); past bootlimit, altbootcmd (uboot-patches/003) boots the extlinux
# FALLBACK label, the slot that ran before. CONFIG_SYS_BOOTCOUNT_ADDR is scratch RAM below kernel_addr_r.
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_FS=y
CONFIG_SYS_BOOTCOUNT_FS_INTERFACE="mmc"
CONFIG_SYS_BOOTCOUNT_FS_DEVPART="1:1"
CONFIG_SYS_BOOTCOUNT_FS_NAME="/bootcount"
CONFIG_SYS_BOOTCOUNT_ADDR=0x00f00000
CONFIG_BOOTCOUNT_BOOTLIMIT=3
CONFIG_FAT_WRITE=y
# One card for the RG DS and the RG DS Plus: before booting, the SARADC's channel 5 (uboot-patches/004) names the
# handheld, about 1.06 V on the RG DS and 1.77 V on the Plus, and $fdtfile becomes its device tree, which the card's
# extlinux.conf loads (FDTDIR). No reading at all (an error) leaves the RG DS's. rgds_board and rgds_adc go on the
# kernel's command line (rgds.detected=, rgds.adc=) for the logs and for the updater, which keeps FDTDIR only on a
# U-Boot that sets them. A card made for one handheld (rgds-os-plus.img) names its device tree itself (FDT).
CONFIG_ADC=y
CONFIG_SARADC_ROCKCHIP=y
CONFIG_CMD_ADC=y
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="setenv rgds_board rgds; setenv rgds_adc none; setenv fdtfile rk3568-anbernic-rg-ds.dtb; adc single saradc@fe720000 5 rgds_adc; if test ${rgds_adc} -gt 1400000; then setenv rgds_board rgds-plus; setenv fdtfile rk3568-anbernic-rg-ds-plus.dtb; fi"
