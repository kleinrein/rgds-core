+/* RG DS Play: the keypad drawn on the touch screen. Bit i of the mask is the key at place i on the controller,
+   read across: 1 2 3, 4 5 6, 7 8 9, * 0 #. The core reads one keypad key at a time, from player 1. */
+static unsigned rgds_keypad_key;
+RETRO_API void retro_rgds_keypad(unsigned port, unsigned mask)
+{
+   static const unsigned keys[12] = {
+      AKEY_5200_1, AKEY_5200_2, AKEY_5200_3, AKEY_5200_4, AKEY_5200_5, AKEY_5200_6,
+      AKEY_5200_7, AKEY_5200_8, AKEY_5200_9, AKEY_5200_ASTERISK, AKEY_5200_0, AKEY_5200_HASH
+   };
+   unsigned i;
+   if (port != 0)
+      return;
+   rgds_keypad_key = 0;
+   for (i = 0; i < 12; i++)
+      if (mask & (1u << i))
+      {
+         rgds_keypad_key = keys[i];
+         break;
+      }
+}
+
 #define A5200_BIOS_FILE_NAME "5200.rom"
 #define A5200_BIOS_SIZE 0x800
 #define A5200_SAVE_STATE_SIZE 131361
@@ -1075,7 +1096,9 @@ static void update_input(void)
          key_code += input_pause_is_reset ? AKEY_5200_RESET : AKEY_5200_PAUSE;
       else if (joypad_bits & (1 << RETRO_DEVICE_ID_JOYPAD_START))
          key_code += AKEY_5200_START;
-      /* Number pad */
+      /* Number pad: the touch screen's first */
+      else if (rgds_keypad_key)
+         key_code += rgds_keypad_key;
       else if (joypad_bits & (1 << RETRO_DEVICE_ID_JOYPAD_Y))
          key_code += AKEY_5200_ASTERISK;
