+/* RG DS: the tape's place after the snapshot (cap32/tape.c). */
+extern size_t rgds_tape_state_size(void);
+extern void rgds_tape_state_save(uint8_t *out);
+extern bool rgds_tape_state_present(const uint8_t *data, size_t size);
+extern void rgds_tape_state_load(const uint8_t *in);
+
 size_t retro_serialize_size(void)
 {
-   return snapshot_size();
+   return snapshot_size() + rgds_tape_state_size();
 }
 
 bool retro_serialize(void *data, size_t size)
 {
    int error;
-   error = snapshot_save_mem((uint8_t *) data, size);
+   if (size < snapshot_size() + rgds_tape_state_size())
+      return false;
+   error = snapshot_save_mem((uint8_t *) data, size - rgds_tape_state_size());
    if(!error)
+   {
+      rgds_tape_state_save((uint8_t *) data + size - rgds_tape_state_size());
       return true;
+   }
 
    LOGI("[retro_serialize] SNA-serialized: error %d\n", error);
    return false;
@@ -1945,7 +1956,14 @@ bool retro_serialize(void *data, size_t size)
 
 bool retro_unserialize(const void *data, size_t size)
 {
-   return !snapshot_load_mem((uint8_t *) data, size);
+   /* A state with the tape's place (RG DS) or one without, as older states and other frontends' are. */
+   const bool tape = rgds_tape_state_present((const uint8_t *) data, size);
+   const size_t snapshot = tape ? size - rgds_tape_state_size() : size;
+   if (snapshot_load_mem((uint8_t *) data, snapshot))
+      return false;
+   if (tape)
+      rgds_tape_state_load((const uint8_t *) data + snapshot);
+   return true;
 }
 
 void *retro_get_memory_data(unsigned id)
diff --git a/libretro/retro_events.c b/libretro/retro_events.c
index c0192ce..ff77f20 100644
--- a/libretro/retro_events.c
+++ b/libretro/retro_events.c
@@ -990,3 +990,33 @@ void ev_lightgun(unsigned port)
    if (retro_video.screen_crop)
       g->x += EMULATION_CROP;
 }
+
+/* RG DS: what RG DS Play needs to know and to undo around its checkpoints. */
+extern void kbd_buf_clean(void);
+
+/**
+ * retro_rgds_loading:
+ * true while the autorun still types the game's command (RUN"... or |TAPE): a
+ * state holds no typing queue, so it would come back with half a command typed.
+ * (A tape's place is in the state: cap32/tape.c rgds_tape_state_save.)
+ **/
+bool retro_rgds_loading(void)
+{
+   return event_call == EV_AUTO;
+}
+
+/**
+ * retro_rgds_cancel_autorun:
+ * a state loaded over a game that has only just started: its autorun command,
+ * queued when the game loaded, would otherwise be typed into the resumed game.
+ **/
+void retro_rgds_cancel_autorun(void)
+{
+   if (event_call != EV_AUTO)
+      return;
+   kbd_buf_feed("");
+   kbd_buf_clean();
+   autorun_delay = EMULATION_INIT_AUTORUNDELAY;
+   wait_computer = 1;
+   ev_set(EV_JOY);
+}
