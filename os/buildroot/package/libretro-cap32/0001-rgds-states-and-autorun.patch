diff --git a/cap32/tape.c b/cap32/tape.c
index efa728e..ee27805 100644
--- a/cap32/tape.c
+++ b/cap32/tape.c
@@ -35,6 +35,9 @@
 #include "tape.h"
 #include "z80.h"
 
+#include <stdbool.h>
+#include <string.h>
+
 #include <streams/file_stream.h>
 #include <streams/file_stream_transforms.h>
 
@@ -611,3 +614,111 @@ void Tape_Rewind(void)
    CPC.tape_play_button = 0;
    Tape_GetNextBlock();
 }
+
+/* RG DS: the tape's place, kept after a state's snapshot (libretro-core.c retro_serialize), so a state taken
+ * between a game's loads (or during one) finds the tape where it was. Pointers are kept as offsets into the tape
+ * image (1 + offset, 0 for none) or into wCycleTable (0x80000000 | index); a state of another tape (another size)
+ * leaves the tape as it is. */
+#define RGDS_TAPE_MAGIC 0x50544752u /* "RGTP" */
+typedef struct {
+   uint32_t magic, image_size;
+   uint32_t ptr[5];
+   uint32_t pulse_cycles, zero_pulse, one_pulse, stage, pulse_count, data_count, bits_to_shift;
+   int32_t cycle_count;
+   uint16_t cycle_table[2];
+   uint8_t level, data, play_button, unused;
+} rgds_tape_state;
+
+static uint32_t rgds_tape_size(void)
+{
+   return pbTapeImage && pbTapeImageEnd > pbTapeImage ? (uint32_t)(pbTapeImageEnd - pbTapeImage) : 0;
+}
+
+static uint32_t rgds_tape_ptr(const void *p)
+{
+   const uint8_t *b = (const uint8_t *)p;
+   if (!p)
+      return 0;
+   if (b >= (const uint8_t *)wCycleTable && b < (const uint8_t *)(wCycleTable + 2) + 1)
+      return 0x80000000u | (uint32_t)((const uint16_t *)p - wCycleTable);
+   if (pbTapeImage && b >= pbTapeImage && b <= pbTapeImageEnd + 6)
+      return 1 + (uint32_t)(b - pbTapeImage);
+   return 0;
+}
+
+static void *rgds_tape_unptr(uint32_t v)
+{
+   if (!v)
+      return NULL;
+   if (v & 0x80000000u)
+      return wCycleTable + (v & 3);
+   return pbTapeImage + (v - 1);
+}
+
+size_t rgds_tape_state_size(void)
+{
+   return sizeof(rgds_tape_state);
+}
+
+void rgds_tape_state_save(uint8_t *out)
+{
+   rgds_tape_state s;
+   memset(&s, 0, sizeof(s));
+   s.magic = RGDS_TAPE_MAGIC;
+   s.image_size = rgds_tape_size();
+   s.ptr[0] = rgds_tape_ptr(pbTapeBlock);
+   s.ptr[1] = rgds_tape_ptr(pbTapeBlockData);
+   s.ptr[2] = rgds_tape_ptr(pwTapePulseTable);
+   s.ptr[3] = rgds_tape_ptr(pwTapePulseTableEnd);
+   s.ptr[4] = rgds_tape_ptr(pwTapePulseTablePtr);
+   s.pulse_cycles = dwTapePulseCycles;
+   s.zero_pulse = dwTapeZeroPulseCycles;
+   s.one_pulse = dwTapeOnePulseCycles;
+   s.stage = dwTapeStage;
+   s.pulse_count = dwTapePulseCount;
+   s.data_count = dwTapeDataCount;
+   s.bits_to_shift = dwTapeBitsToShift;
+   s.cycle_count = iTapeCycleCount;
+   s.cycle_table[0] = wCycleTable[0];
+   s.cycle_table[1] = wCycleTable[1];
+   s.level = bTapeLevel;
+   s.data = bTapeData;
+   s.play_button = (uint8_t)CPC.tape_play_button;
+   memcpy(out, &s, sizeof(s));
+}
+
+/* Whether data ends with a tape trailer. */
+bool rgds_tape_state_present(const uint8_t *data, size_t size)
+{
+   uint32_t magic;
+   if (size < sizeof(rgds_tape_state))
+      return false;
+   memcpy(&magic, data + size - sizeof(rgds_tape_state), sizeof(magic));
+   return magic == RGDS_TAPE_MAGIC;
+}
+
+void rgds_tape_state_load(const uint8_t *in)
+{
+   rgds_tape_state s;
+   memcpy(&s, in, sizeof(s));
+   if (s.magic != RGDS_TAPE_MAGIC || !s.image_size || s.image_size != rgds_tape_size())
+      return;
+   pbTapeBlock = (uint8_t *)rgds_tape_unptr(s.ptr[0]);
+   pbTapeBlockData = (uint8_t *)rgds_tape_unptr(s.ptr[1]);
+   pwTapePulseTable = (uint16_t *)rgds_tape_unptr(s.ptr[2]);
+   pwTapePulseTableEnd = (uint16_t *)rgds_tape_unptr(s.ptr[3]);
+   pwTapePulseTablePtr = (uint16_t *)rgds_tape_unptr(s.ptr[4]);
+   dwTapePulseCycles = s.pulse_cycles;
+   dwTapeZeroPulseCycles = s.zero_pulse;
+   dwTapeOnePulseCycles = s.one_pulse;
+   dwTapeStage = s.stage;
+   dwTapePulseCount = s.pulse_count;
+   dwTapeDataCount = s.data_count;
+   dwTapeBitsToShift = s.bits_to_shift;
+   iTapeCycleCount = s.cycle_count;
+   wCycleTable[0] = s.cycle_table[0];
+   wCycleTable[1] = s.cycle_table[1];
+   bTapeLevel = s.level;
+   bTapeData = s.data;
+   CPC.tape_play_button = s.play_button;
+}
