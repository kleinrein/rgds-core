From: RG DS <rgds@localhost>
Subject: [PATCH] libretro: the VMU screens for the second screen

retro_rgds_vmu(index, dots) gives RG DS Play the picture each VMU shows, as the
game drew it, so the handheld's lower panel can show it large.
---
diff --git a/core/rend/osd.cpp b/core/rend/osd.cpp
index a88d8d7..fbb5738 100644
--- a/core/rend/osd.cpp
+++ b/core/rend/osd.cpp
@@ -23,12 +23,16 @@
 u32 vmu_lcd_data[8][48 * 32];
 bool vmu_lcd_status[8];
 u64 vmuLastChanged[8];
+// RG DS Play's second screen: each VMU's picture as the game drew it, 1 where a dot is dark (retro_rgds_vmu)
+u8 rgds_vmu_dots[8][48 * 32];
 
 void push_vmu_screen(int bus_id, int bus_port, u8* buffer)
 {
 	int vmu_id = bus_id * 2 + bus_port;
 	if (vmu_id < 0 || vmu_id >= (int)std::size(vmu_lcd_data))
 		return;
+	for (int i = 0; i < 48 * 32; i++)
+		rgds_vmu_dots[vmu_id][i] = buffer[i] == 0;
 	u32 *p = &vmu_lcd_data[vmu_id][0];
 	for (int i = 0; i < (int)std::size(vmu_lcd_data[vmu_id]); i++, buffer++)
 #ifdef LIBRETRO
diff --git a/shell/libretro/libretro.cpp b/shell/libretro/libretro.cpp
index c5f781a..727e9a6 100644
--- a/shell/libretro/libretro.cpp
+++ b/shell/libretro/libretro.cpp
@@ -2685,6 +2685,18 @@ static void refresh_devices(bool first_startup)
 }
 
 // API version (to detect version mismatch)
+extern u8 rgds_vmu_dots[8][48 * 32];
+// RG DS Play: the picture on VMU `index` (0: controller A's first slot), 48 x 32 bytes into dots when not null, 1 for
+// a dark dot; returns when the game last drew it (milliseconds, 0: never).
+extern "C" RETRO_API unsigned long long retro_rgds_vmu(unsigned index, unsigned char *dots)
+{
+	if (index >= 8)
+		return 0;
+	if (dots != nullptr)
+		memcpy(dots, rgds_vmu_dots[index], sizeof(rgds_vmu_dots[index]));
+	return vmuLastChanged[index];
+}
+
 unsigned retro_api_version()
 {
    return RETRO_API_VERSION;
