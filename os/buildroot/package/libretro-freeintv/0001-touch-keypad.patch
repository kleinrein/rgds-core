+/* RG DS Play: the keypad drawn on the touch screen. Bit i of a port's mask is the key at place i on the
+   controller, read across: 1 2 3, 4 5 6, 7 8 9, Clear 0 Enter (keypadStates' own order). */
+static unsigned rgds_keypad[2];
+
+RETRO_API void retro_rgds_keypad(unsigned port, unsigned mask)
+{
+	if (port < 2)
+		rgds_keypad[port] = mask;
+}
+
+static void rgds_keypad_input(int player)
+{
+	int i;
+	for (i = 0; i < 12; i++)
+		if (rgds_keypad[player] & (1u << i))
+		{
+			setControllerInput(player, keypadStates[i]);
+			return;
+		}
+}
+
