Remember when a loader last read the tape: ten or more port 0xfe reads in a row
that look like a loader (close together, B counting by one), as Fuse's own
loader detection judges them. loader_tape_loading() is true while the tape plays
and such a read came in the last two frames, so RG DS Play hurries a loading tape
along but not a game that runs with the tape still playing (Out Run). A tape no
loader has read for three seconds stops, so a multiload game finds its next part
where the last one ended; loader detection starts it again.

diff --git a/fuse/loader.c b/fuse/loader.c
index 7159bbe..fd30a73 100644
--- a/fuse/loader.c
+++ b/fuse/loader.c
@@ -36,6 +36,11 @@ static int successive_reads = 0;
 static libspectrum_signed_dword last_tstates_read = -100000;
 static libspectrum_byte last_b_read = 0x00;
 static int length_known1 = 0, length_known2 = 0;
+/* RG DS Play: frames since the last of ten or more loader-like reads in a
+   row, so the player can tell a loader reading the tape from a game that
+   merely leaves it playing */
+static int loading_reads = 0;
+static int frames_since_loading = 1000;
 static int length_long1 = 0, length_long2 = 0;
 
 typedef enum acceleration_mode_t {
@@ -53,6 +58,19 @@ loader_frame( libspectrum_dword frame_length )
   if( last_tstates_read > -100000 ) {
     last_tstates_read -= frame_length;
   }
+  /* and stops a tape no loader has read for three seconds, the way one would
+     stop a real one, so a multiload game that runs without reading port 0xfe
+     (Out Run, on a joystick) finds its next part where it left the tape;
+     loader detection starts it again when the next loader polls */
+  if( frames_since_loading < 1000 && ++frames_since_loading == 150 &&
+      tape_is_playing() )
+    tape_stop();
+}
+
+int
+loader_tape_loading( void )
+{
+  return tape_is_playing() && frames_since_loading < 2;
 }
 
 void
@@ -411,6 +429,12 @@ loader_detect_loader( void )
   last_tstates_read = tstates;
   last_b_read = z80.bc.b.h;
 
+  if( tstates_diff <= 1000 && ( b_diff == 0 || b_diff == 1 || b_diff == 0xff ) ) {
+    if( ++loading_reads >= 10 ) frames_since_loading = 0;
+  } else {
+    loading_reads = 0;
+  }
+
   if( settings_current.detect_loader ) {
 
     if( tape_is_playing() ) {
diff --git a/fuse/loader.h b/fuse/loader.h
index e73467a..d88c368 100644
--- a/fuse/loader.h
+++ b/fuse/loader.h
@@ -30,6 +30,7 @@ void loader_frame( libspectrum_dword frame_length );
 void loader_tape_play( void );
 void loader_tape_stop( void );
 void loader_detect_loader( void );
+int loader_tape_loading( void );
 void loader_set_acceleration_flags( int flags, int from_acceleration );
 
 #endif			/* #ifndef FUSE_LOADER_H */
