config BR2_PACKAGE_LIBRETRO_GEARCOLECO
	bool "libretro-gearcoleco"
	depends on BR2_INSTALL_LIBSTDCPP
	help
	  Gearcoleco, the ColecoVision core RG DS Play loads for .col games:
	  /usr/lib/libretro/gearcoleco_libretro.so. It needs the owner's
	  colecovision.rom in the BIOS folder. 0001 lets the player press the
	  controller's keypad from the touch screen.
