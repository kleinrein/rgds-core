+void GLProfiler::ReadSlot(Slot &slot) {
+	double frame = 0.0;
+	for (const GLProfilerScope &scope : slot.scopes) {
+		if (scope.endQueryId == -1) {
+			WARN_LOG(Log::G3D, "Unclosed scope: %s", scope.name);
+			continue;
+		}
+		GLuint64 startTime = 0, endTime = 0;
+		glGetQueryObjectui64v(slot.queries[scope.startQueryId], GL_QUERY_RESULT, &startTime);
+		glGetQueryObjectui64v(slot.queries[scope.endQueryId], GL_QUERY_RESULT, &endTime);
+		// Signed: Panfrost's job manager writes a stamp from the vertex chain of a fresh batch, whose order against
+		// the pass's own batch is not kept, so stamp deltas can come out negative; finish mode uses the CPU clock.
+		const double ms = (double)(int64_t)(endTime - startTime) / 1000000.0;
+		Sum &sum = sums_[scope.name];
+		sum.ms += ms;
+		sum.issue += 1000.0 * (scope.cpuIssued - scope.cpuBegin);
+		sum.wait += 1000.0 * (scope.cpuDone - scope.cpuIssued);
+		sum.frames++;
+		if (scope.level == 0) {
+			frame += FinishEach() ? 1000.0 * (scope.cpuDone - scope.cpuBegin) : ms;
+			issueMs_ += 1000.0 * (scope.cpuIssued - scope.cpuBegin);
+		}
+	}
+	frameMs_ += frame;
+	framesSummed_++;
+	if (framesSummed_ >= ReportEvery()) {
+		if (FinishEach())
+			fprintf(stderr, "gl passes: %d frames, %.2f ms a frame drained, %.2f ms issuing, %.2f ms in the profiler's query reads (steps in order: avg ms issuing the commands + waiting for the GPU when present, %% of frames)\n", framesSummed_, frameMs_ / framesSummed_, issueMs_ / framesSummed_, readMs_ / framesSummed_);
+		else
+			fprintf(stderr, "gl passes: %d frames, GPU stamps %.2f ms a frame, %.2f ms issuing, %.2f ms in the profiler's query reads (steps in order: avg stamp ms + issue ms when present, %% of frames)\n", framesSummed_, frameMs_ / framesSummed_, issueMs_ / framesSummed_, readMs_ / framesSummed_);
+		for (const auto &entry : sums_) {
+			const Sum &sum = entry.second;
+			if (FinishEach())
+				fprintf(stderr, "  %7.3f issue %7.3f wait %3d%%  %s\n", sum.issue / sum.frames, sum.wait / sum.frames, sum.frames * 100 / framesSummed_, entry.first.c_str());
+			else
+				fprintf(stderr, "  %9.3f stamp %7.3f issue %3d%%  %s\n", sum.ms / sum.frames, sum.issue / sum.frames, sum.frames * 100 / framesSummed_, entry.first.c_str());
+		}
+		fflush(stderr);
+		sums_.clear();
+		framesSummed_ = 0;
+		frameMs_ = 0.0;
+		issueMs_ = 0.0;
+		readMs_ = 0.0;
+	}
+}
