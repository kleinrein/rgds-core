 	if (event.type == Common::EVENT_QUIT && (g_system->hasFeature(OSystem::kFeatureNoQuit) || (ConfMan.getBool("gui_return_to_launcher_at_exit") && g_engine && g_engine->hasFeature(Engine::kSupportsReturnToLauncher))))
 		event.type = Common::EVENT_RETURN_TO_LAUNCHER;
 
+	// RG DS Play: the first request to leave keeps where the game was (the core asks until the engine has gone,
+	// as a quit or as a return to the launcher).
+	if ((event.type == Common::EVENT_QUIT || event.type == Common::EVENT_RETURN_TO_LAUNCHER) && g_engine &&
+			!_shouldQuit && !_shouldReturnToLauncher && !_confirmExitDialogActive)
+		g_engine->saveAutosaveOnQuit();
+
 	switch (event.type) {
 	case Common::EVENT_KEYDOWN:
 		_modifierState = event.kbd.flags;
diff -ru a/base/main.cpp b/base/main.cpp
--- a/base/main.cpp	2026-11-10 23:13:03
+++ b/base/main.cpp	2026-11-10 23:13:04
@@ -324,6 +324,19 @@
 	system.getEventManager()->purgeKeyboardEvents();
 	system.getEventManager()->purgeMouseEvents();
 
+	// RG DS Play: a game goes on from where it was left, if its autosave is there (written every few minutes and
+	// by Engine::saveAutosaveOnQuit) and the engine can load a save as it starts.
+	if (!ConfMan.hasKey("save_slot") && metaEngine.hasFeature(MetaEngine::kSupportsLoadingDuringStartup)) {
+		const int autoSaveSlot = metaEngine.getAutosaveSlot();
+		const SaveStateList saves = autoSaveSlot < 0 ? SaveStateList() : metaEngine.listSaves(target.c_str());
+		for (const auto &save : saves) {
+			if (save.getSaveSlot() == autoSaveSlot) {
+				ConfMan.setInt("save_slot", autoSaveSlot, Common::ConfigManager::kTransientDomain);
+				break;
+			}
+		}
+	}
+
 	// Run the engine
 	Common::Error result = engine->run();
 
