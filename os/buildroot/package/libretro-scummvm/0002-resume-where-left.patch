 }
 
+void Engine::saveAutosaveOnQuit() {
+	if (_autoSaving)
+		return;
+	const int autoSaveSlot = getAutosaveSlot();
+	if (autoSaveSlot < 0 || !canSaveAutosaveCurrently())
+		return;
+	const SaveStateDescriptor desc = getMetaEngine()->querySaveMetaInfos(_targetName.c_str(), autoSaveSlot);
+	if (desc.isValid() && !desc.isAutosave())
+		return;
+	_autoSaving = true;
+	if (saveGameState(autoSaveSlot, Common::convertFromU32String(_("Autosave")), true).getCode() != Common::kNoError)
+		warning("The autosave on leaving could not be written");
+	_lastAutosaveTime = _system->getMillis();
+	_autoSaving = false;
+}
+
 void Engine::errorString(const char *buf1, char *buf2, int size) {
 	Common::strlcpy(buf2, buf1, size);
 }
