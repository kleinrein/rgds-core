Training builds only (train.sh): the player leaves by _exit, which skips gcov's own dump, so a thread dumps the
counters RGDS_GCOV_AFTER seconds after the library loads. The profile still matches without it: the functions come
last in the file and the package never defines RGDS_PGO_TRAIN.

--- a/src/gallium/drivers/panfrost/pan_screen.c
+++ b/src/gallium/drivers/panfrost/pan_screen.c
@@ -995,3 +995,27 @@
 
    return &screen->base;
 }
+
+#ifdef RGDS_PGO_TRAIN
+/* Training build only: the player leaves by _exit, which skips gcov's own dump. */
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+extern void __gcov_dump(void);
+static void *
+rgds_pgo_dump(void *arg)
+{
+   sleep(atoi(getenv("RGDS_GCOV_AFTER")));
+   __gcov_dump();
+   fprintf(stderr, "rgds pgo: profile dumped\n");
+   return NULL;
+}
+__attribute__((constructor)) static void
+rgds_pgo_start(void)
+{
+   pthread_t t;
+   if (getenv("RGDS_GCOV_AFTER") && !pthread_create(&t, NULL, rgds_pgo_dump, NULL))
+      pthread_detach(t);
+}
+#endif
