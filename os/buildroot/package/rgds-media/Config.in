config BR2_PACKAGE_RGDS_MEDIA
	bool "rgds-media"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_SYNC_4 # harfbuzz (libass, mupdf)
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9 # harfbuzz
	select BR2_PACKAGE_FFMPEG
	select BR2_PACKAGE_FFMPEG_SWSCALE
	select BR2_PACKAGE_LIBASS
	select BR2_PACKAGE_MUPDF
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_ZLIB
	help
	  RG DS Media (play/src/media, docs/MEDIA_PLAN.md): films and books on both screens, /usr/bin/rgds-media,
	  started from Home's Media tile by runtime/media.py. FFmpeg plays the films (libass draws their
	  subtitles), MuPDF opens PDF, EPUB, CBZ and the rest. Built against the image's own libraries, as the music
	  engine is.
