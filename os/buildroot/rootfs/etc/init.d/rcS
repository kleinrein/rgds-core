#!/bin/sh
# RG DS OS's whole boot: mount, find the card, make or mount the data partition, then init starts RG DS Core.
# Panels, touch, buttons and the GPU are built into the kernel, so nothing is waited for but the data partition;
# Wi-Fi and SSH come up in the background. Milestones go to /run/rgds/boot-times (and data/rgds/logs/boot.txt).
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm
ln -sfn /proc/self/fd /dev/fd
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp
mount -t tmpfs -o mode=0700 tmpfs /root
mkdir -p /run/rgds /var/log
# playback goes to the speaker until headphones or a Bluetooth headset take it (/etc/asound.conf,
# usr/libexec/rgds/audio and bt-audio); the RG DS Plus's amplifier card may come later (the headphones watcher)
/usr/libexec/rgds/audio setup 2>> /run/rgds/messages
mark() { read up rest < /proc/uptime; printf '%-28s %6.2f s\n' "$1" "$up" >> /run/rgds/boot-times; }
mark "rcS: started"
sysctl -q -p /etc/sysctl.d/rgds.conf
hostname rgds
# the device's own address is delivered through lo: down, file sharing's self-check (and anything else that
# connects to the handheld from itself) times out
ip link set lo up
syslogd -O /run/rgds/messages -s 256 -b 1

# the card we booted from: its partitions 2 and 3 are the root slots, 4 the data partition. It is the disk the root
# filesystem is on; failing that, the one whose partition 2 is named rgds-root-a. Never a guess: the next lines
# partition and format what is named here, and the eMMC (the factory system) must not be it. With no card found
# there is no data partition, and the menu says so (data-failed, the session's --card-problem).
DISK=
root=$(mountpoint -d / 2>/dev/null)
p=$(readlink -f "/sys/dev/block/$root" 2>/dev/null)
case "${p##*/}" in mmcblk*p[23]) DISK=/dev/${p##*/}; DISK=${DISK%p[23]};; esac
[ -n "$DISK" ] || for u in /sys/class/block/*p2/uevent; do
    grep -q '^PARTNAME=rgds-root-a$' "$u" 2>/dev/null || continue
    p=${u%/uevent}; DISK=/dev/${p##*/}; DISK=${DISK%p2}
done
[ -n "$DISK" ] || DISK=/dev/none
echo "$DISK" > /run/rgds/disk
SLOT=a; grep -q 'root=PARTLABEL=rgds-root-b' /proc/cmdline && SLOT=b
echo "$SLOT" > /run/rgds/slot
mark "rcS: slot $SLOT"
if [ ! -b "$DISK" ]; then
    echo "rcS: the card RG DS OS booted from was not found" >> /run/rgds/messages
elif [ ! -b ${DISK}p4 ]; then
    /usr/libexec/rgds/firstboot "$DISK"
elif grep -q '^PARTNAME=rgds-new$' /sys/class/block/${DISK##*/}p4/uevent 2>/dev/null; then
    /usr/libexec/rgds/firstboot --format "$DISK"
fi
data() { mount -t exfat -o noatime,uid=0,gid=0,fmask=0000,dmask=0000,iocharset=utf8,errors=remount-ro ${DISK}p4 /data 2>/dev/null; }
data || { fsck.exfat -y ${DISK}p4 >/dev/null 2>&1; data; } || mount -o noatime ${DISK}p4 /data 2>/dev/null || {
    mount -t tmpfs -o mode=0755 tmpfs /data
    echo "${DISK}p4 could not be mounted" > /run/rgds/data-failed
}
mkdir -p /data/rgds/userdata /data/rgds/logs /data/rgds/cache/mesa /data/rgds/ssh /data/roms/nds /data/roms/gba \
    /data/roms/gb /data/roms/gbc /data/roms/nes /data/roms/snes /data/roms/md /data/roms/genesis /data/roms/sms /data/roms/psx /data/roms/n64 /data/roms/zx /data/roms/c64 /data/roms/psp /data/roms/dc /data/roms/gw /data/roms/scummvm \
    /data/roms/segacd /data/roms/pico /data/roms/coleco /data/roms/intellivision /data/roms/msx /data/roms/pce /data/roms/pcecd /data/roms/atari /data/roms/amiga /data/roms/pico8 \
    /data/rgds/bios
# the 3DS folder where the engine is (emulators.tanuki_engine: in the image since 0.9.1, or on the data partition)
for e in /data/rgds/engines/tanuki3ds /usr/share/rgds/engines/tanuki3ds; do [ -f $e/run.sh ] && mkdir -p /data/roms/3ds; done
mark "rcS: data ready"
/usr/libexec/rgds/saved-brightness
# what the last kernel crash left in RAM (ramoops in the device tree), moved to the card. Every restart leaves a
# console-* file; only a dmesg-* one means a crash. Removing them makes room for the next.
mount -t pstore pstore /sys/fs/pstore 2>/dev/null
# The newest 20 are kept, numbered upwards (before 2026-11-10 the first 20 were, and later crashes were dropped).
if ls /sys/fs/pstore/dmesg-* >/dev/null 2>&1; then
    P=/data/rgds/logs/pstore
    n=$(ls $P 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tail -n 1)
    n=$((${n:--1} + 1))
    mkdir -p $P/$n && cp /sys/fs/pstore/* $P/$n/ 2>/dev/null
    for old in $(ls $P | grep -E '^[0-9]+$' | sort -n -r | tail -n +21); do rm -rf "$P/$old"; done
fi
rm -f /sys/fs/pstore/* 2>/dev/null
mount -t vfat -o ro,noatime ${DISK}p1 /boot 2>/dev/null
# a slot switch on trial (usr/libexec/rgds/trial): a fallback U-Boot made is recorded for the launcher, and a trial
# slot that never commits (the session commits once RG DS Core has stayed up) restarts so U-Boot's counter advances
/usr/libexec/rgds/trial boot
case "$(/usr/libexec/rgds/trial status)" in trial*) ( sleep 240; case "$(/usr/libexec/rgds/trial status)" in trial*) reboot;; esac ) & ;; esac
# set up on a computer right after flashing, before the data partition exists: rgds-setup/ on the boot
# partition (wifi.conf, authorized_keys) is copied in once
[ -f /boot/rgds-setup/wifi.conf ] && [ ! -f /data/rgds/wifi.conf ] && cp /boot/rgds-setup/wifi.conf /data/rgds/wifi.conf
[ -f /boot/rgds-setup/authorized_keys ] && [ ! -f /data/rgds/ssh/authorized_keys ] &&
    cp /boot/rgds-setup/authorized_keys /data/rgds/ssh/authorized_keys

# the amber LED follows the charger: blinking while charging, solid when full, off on battery (the power-supply
# core's LED trigger, re-attached on every status change by charge-led; the LED keeps its state through sleep,
# dts-patches/0004)
/usr/libexec/rgds/charge-led &
# the menu at full speed: the GPU's devfreq starts at its lowest clock (200 MHz), where a frame took 68 ms
echo performance > /sys/class/devfreq/fde60000.gpu/governor 2>/dev/null
# device interrupts on CPU 0 only (DSCore's aux core); CPUs 1-3 run the emulator's threads undisturbed
echo 1 > /proc/irq/default_smp_affinity 2>/dev/null
for i in /proc/irq/[0-9]*/smp_affinity; do echo 1 > "$i" 2>/dev/null; done

(
    hwclock -s 2>/dev/null
    # the USB cable as a network; before net, which starts SSH
    /usr/libexec/rgds/usb up 2>> /run/rgds/messages
    /usr/libexec/rgds/net up
) &
# the speakers follow the headphone jack; the handheld powers off before the battery is empty
/usr/libexec/rgds/headphones >> /run/rgds/messages 2>&1 &
/usr/libexec/rgds/battery-watch >> /run/rgds/messages 2>&1 &
# what this handheld is and found, for a report from a card read on a computer (rgds/logs/hardware.txt): the board
# U-Boot detected and its ID voltage, the device tree, the sound cards, the panels' modes, and the system log
hardware() {
    { echo "model: $(tr -d '\0' < /proc/device-tree/model)"; echo "cmdline: $(cat /proc/cmdline)"
      /usr/libexec/rgds/audio cards; cat /proc/asound/cards
      for m in /sys/class/drm/card*-DSI-*/modes; do echo "${m%/modes}: $(head -n 1 "$m")"; done
      echo; cat /run/rgds/messages; } > /data/rgds/logs/hardware.txt 2>&1
}
( sleep 20; cp /run/rgds/boot-times /data/rgds/logs/boot.txt; dmesg > /data/rgds/logs/dmesg.txt; hardware
  sleep 100; hardware ) &
exit 0
