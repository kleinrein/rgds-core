#!/bin/sh
# The amber LED follows the charger: blinking while charging, solid when full, off on battery. The kernel's
# battery-charging-blink-full-solid trigger only re-evaluates on a power-supply change event, and the PMIC does
# not send one when the charger is unplugged: the LED kept blinking on battery. Re-attaching the trigger
# re-reads the status, so it is re-attached whenever the status changes. Started by rcS.
L=${RGDS_CHARGE_LED:-/sys/class/leds/amber:charging}
B=${RGDS_BATTERY_DIR:-/sys/class/power_supply/battery}
T=battery-charging-blink-full-solid
last=
while :; do
    s=$(cat $B/status 2>/dev/null)
    if [ "$s" != "$last" ]; then
        echo none > $L/trigger 2>/dev/null
        echo 0 > $L/brightness 2>/dev/null
        echo $T > $L/trigger 2>/dev/null
        last=$s
    fi
    sleep "${RGDS_CHARGE_LED_INTERVAL:-2}"
done
