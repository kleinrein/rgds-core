#!/bin/sh
# What RG DS Flasher kept from an old card (BananaOS: saves, states, play time, BIOS files) before it erased it.
# The flasher writes it past the image, at the card's end: a gzip'd tar, and at the start of the card's last MiB a
# line "RGDS-CARRY 1 <offset> <length> <sha256>" (offset on a MiB). The first boot's data partition then covers
# that place without writing there: mkfs.exfat writes its metadata at the partition's start, sfdisk only wipes
# known signatures, and nothing fills the partition before this runs (rcS, right after it is mounted). The bundle
# goes to import/flasher.tar.gz once, checked; setup's Bring over step (runtime/migrate.py) unpacks it.
# Looked for on the first boot only: handoff.done says it was.
# The bundle may also hold preset.ini, the flasher's Set up step (flasher/preset.go): a Wi-Fi network goes into
# wifi.conf here, before Wi-Fi starts, and the rest (language, time zone, name) into userdata/flasher-setup.ini for
# setup (src/launcher/welcome_screen.hpp), and a developer's SSH key (ssh_key=) into ssh/authorized_keys. A bundle
# with nothing else in it is not kept for Bring over.
#   handoff <disk>
DISK=$1
OUT=${RGDS_HANDOFF_OUT:-/data/rgds/import}
DATA=${RGDS_HANDOFF_DATA:-/data/rgds}

# preset <preset.ini>: the network to wifi.conf, the other answers to userdata/flasher-setup.ini
preset() {
    ssid=$(sed -n 's/^wifi_ssid=\([0-9a-f]*\)$/\1/p' "$1" | head -n 1)
    psk=$(sed -n 's/^wifi_psk=\([0-9a-f]\{64\}\)$/\1/p' "$1" | head -n 1)
    if [ -n "$ssid" ] && { [ -n "$psk" ] || grep -qx 'wifi_open=1' "$1"; }; then
        if [ -n "$psk" ]; then key="psk=$psk"; else key="key_mgmt=NONE"; fi
        # scan_ssid: a hidden network is found too
        printf '\nnetwork={\n\tssid=%s\n\tscan_ssid=1\n\t%s\n}\n' "$ssid" "$key" >> $DATA/wifi.conf
        echo "handoff: Wi-Fi network from RG DS Flasher" >> /run/rgds/messages
    fi
    # a developer's flash (flasher --ssh-key): the key lets SSH in from the first boot (net starts dropbear on it)
    key=$(sed -n 's/^ssh_key=\(\(ssh-ed25519\|ssh-rsa\|ecdsa-sha2-nistp256\) [A-Za-z0-9+/]*=*\)$/\1/p' "$1" | head -n 1)
    if [ -n "$key" ]; then
        mkdir -p $DATA/ssh
        grep -qxF "$key" $DATA/ssh/authorized_keys 2>/dev/null || echo "$key" >> $DATA/ssh/authorized_keys
        echo "handoff: SSH key from RG DS Flasher" >> /run/rgds/messages
    fi
    mkdir -p $DATA/userdata
    grep -E '^(format|language|timezone|name)=' "$1" > $DATA/userdata/flasher-setup.ini
}
[ -f $OUT/handoff.done ] && exit 0
mkdir -p $OUT || exit 0
sectors=$(cat /sys/class/block/${DISK##*/}/size 2>/dev/null)
case $sectors in '' | *[!0-9]*) exit 0 ;; esac
set -- $(dd if="$DISK" bs=1048576 skip=$((sectors / 2048 - 1)) count=1 2>/dev/null | head -c 200 | head -n 1 | tr -cd 'A-Za-z0-9 -')
if [ "$1" != RGDS-CARRY ] || [ "$2" != 1 ]; then
    echo none > $OUT/handoff.done
    exit 0
fi
off=$3 len=$4 sum=$5
case "$off$len" in '' | *[!0-9]*) echo bad > $OUT/handoff.done; exit 0 ;; esac
dd if="$DISK" bs=1048576 skip=$((off / 1048576)) count=$(((len + 1048575) / 1048576)) 2>/dev/null |
    head -c "$len" > $OUT/flasher.tar.gz.part
if [ "$(sha256sum $OUT/flasher.tar.gz.part | cut -d' ' -f1)" = "$sum" ]; then
    mv -f $OUT/flasher.tar.gz.part $OUT/flasher.tar.gz
    echo "$sum" > $OUT/handoff.done
    echo "handoff: $len bytes from RG DS Flasher" >> /run/rgds/messages
    # BusyBox tar here has no -z: gunzip feeds it
    names=$(gunzip -c $OUT/flasher.tar.gz 2>/dev/null | tar -tf - 2>/dev/null)
    if echo "$names" | grep -qx preset.ini &&
        gunzip -c $OUT/flasher.tar.gz 2>/dev/null | tar -xOf - preset.ini > $OUT/preset.ini 2>/dev/null; then
        preset $OUT/preset.ini
    fi
    rm -f $OUT/preset.ini
    # an unreadable list keeps the bundle: Bring over (migrate.py) reads it with Python's tarfile
    [ -n "$names" ] && ! echo "$names" | grep -qx manifest.json && rm -f $OUT/flasher.tar.gz
else
    rm -f $OUT/flasher.tar.gz.part
    echo bad > $OUT/handoff.done
    echo "handoff: the flasher's bundle did not check out" >> /run/rgds/messages
fi
exit 0
