#!/bin/sh
# RG DS Core, straight onto both panels (KMSDRM, no compositor), with touch read from the bottom panel's
# touchscreen. init starts this again if it ever exits. Its log: rgds/logs/launcher.log on the card (the previous
# five runs' as .1 to .5), ending in how the launcher exited; crash records are in rgds/userdata/logs/crashes.log.
APP=/usr/share/rgds/releases/$(cat /usr/share/rgds/active)
LOG=/data/rgds/logs/launcher.log
export HOME=/root XDG_RUNTIME_DIR=/run/rgds
/usr/libexec/rgds/saved-brightness
# naming the render driver turns SDL2's batching off unless it is asked for (35-170 ms a panel without it)
export SDL_VIDEODRIVER=kmsdrm SDL_KMSDRM_FIRST=DSI-2 SDL_RENDER_DRIVER=opengles2 SDL_RENDER_BATCHING=1
export SDL_TOUCH_MOUSE_EVENTS=0 SDL_MOUSE_TOUCH_EVENTS=0 RGDS_SDL_LIBRARY=/usr/lib/libSDL2-2.0.so.0
# RGDS_OS=1: RG DS Core hides what only stock firmware has (the Startup page's boot choice)
export RGDS_SESSION_PLATFORM=independent RGDS_INPUT_PROFILE=mainline-rg-ds RGDS_LAUNCH_PROFILE=1 RGDS_OS=1
export MESA_SHADER_CACHE_DIR=/data/rgds/cache/mesa
# the bottom panel's touchscreen sits on i2c-5 (fe5e0000)
for e in /sys/class/input/event*; do
    case "$(readlink -f "$e/device")" in *fe5e0000.i2c*) export RGDS_TOUCH_DEV=/dev/input/${e##*/};; esac
done
# Use as USB drive (runtime/device_services.py): the menu quit for it, and the data partition is the computer's until
# usr/libexec/rgds/usb returns. The screen saying so is the launcher on a data folder in memory, with this handheld's
# language and look.
if [ -f /run/rgds/usb-drive ]; then
    rm -f /run/rgds/usb-drive
    UI=/run/rgds/usb-drive-ui
    mkdir -p $UI
    cp /data/rgds/userdata/ui.ini $UI/ 2> /dev/null
    MESA_SHADER_CACHE_DIR=$UI /usr/libexec/rgds/usb drive $APP/bin/rgds-launcher --app $APP --data $UI --top-display 0 \
        --bottom-display 1 --usb-drive-screen >> /run/rgds/messages 2>&1
fi
i=4
while [ $i -gt 0 ]; do
    [ -f $LOG.$i ] && mv -f $LOG.$i $LOG.$((i + 1))
    i=$((i - 1))
done
[ -f $LOG ] && mv -f $LOG $LOG.1
# PortMaster (runtime/portmaster.py): its entry, then the ports it installs on the data partition
mkdir -p /data/portmaster/ports
# the entry's and the ports' covers (PortMaster's icon before it is installed) and which ports still need their
# owner's files, beside the boot at low priority: the launcher picks the covers up when Ports is opened
nice -n 10 python3 -B $APP/runtime/portmaster.py artwork --app $APP --data /data/rgds/userdata \
    > /data/rgds/logs/portmaster-artwork.log 2>&1 &
# the lid: the hall sensor's switch, and its platform device's wakeup file (sleep on lid close, wake on open)
for e in /sys/class/input/event*; do
    case "$(cat "$e/device/name" 2>/dev/null)" in gpio-keys-hall)
        d=$(readlink -f "$e/device")  # .../platform/gpio-keys-hall/input/inputN: the platform device owns wakeup
        export RGDS_LID_DEV=/dev/input/${e##*/} RGDS_LID_WAKEUP=${d%/input/*}/power/wakeup;; esac
done
read up rest < /proc/uptime; printf '%-28s %6.2f s\n' "session: RG DS Core" "$up" >> /run/rgds/boot-times
# --boot-startup: the boot scene from the first frame, with the hardware probe and the library scan behind it
# Startup > Touch to continue (boot.ini warning=1): a start screen that waits for a tap or A
# --first-run: setup on a card that has not been used yet (setup.ini remembers)
WARN=; grep -qx 'warning=1' /data/rgds/userdata/boot.ini 2>/dev/null && WARN=--boot-warning
# CPU 3 is the emulation core (DSCore's thread layout pins its emulation thread there, RG DS Play its main
# loop): the launcher and its helpers stay on CPUs 0-2, so a game's frame is never queued behind them. A game itself
# is started on every CPU (runtime/linux_platform.py, all_cpus): DSCore pins nothing unless it may use all four.
PIN=; command -v taskset > /dev/null && PIN="taskset -c 0-2"
# a slot on trial after an update is committed once the launcher has stayed up a minute ($$ is this shell, which
# waits for the launcher; a crash and a respawn give the session a new pid). The updater commits earlier, when Home
# is reached.
( sleep 60; kill -0 $$ 2>/dev/null && /usr/libexec/rgds/trial commit ) &
$PIN $APP/bin/rgds-launcher --app $APP --data /data/rgds/userdata --top-display 0 --bottom-display 1 \
    --boot-startup --first-run $WARN --allow-launch --rom-dir /data/roms/nds --system-dir gba=/data/roms/gba --system-dir gbc=/data/roms/gbc \
    --system-dir gb=/data/roms/gb \
    --system-dir nes=/data/roms/nes --system-dir snes=/data/roms/snes --system-dir md=/data/roms/md --system-dir md=/data/roms/genesis \
    --system-dir sms=/data/roms/sms --system-dir psx=/data/roms/psx --system-dir n64=/data/roms/n64 --system-dir zx=/data/roms/zx --system-dir c64=/data/roms/c64 --system-dir 3ds=/data/roms/3ds --system-dir psp=/data/roms/psp --system-dir ports=$APP/runtime/portmaster_files/entry \
    --system-dir ports=/data/portmaster/ports >> $LOG 2>&1
status=$?
# 128 + the signal when it was killed. The kernel's side goes with it: an out-of-memory kill (137) records nothing
# itself, and GPU and card errors show here.
read up rest < /proc/uptime
echo "session: launcher exited, status $status, uptime $up s" >> $LOG
[ $status -ne 0 ] && dmesg | tail -n 200 >> $LOG 2>&1
