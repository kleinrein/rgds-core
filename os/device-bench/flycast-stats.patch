# Measuring edits for Flycast (not a package patch): RGDS_FLYCAST_STATS=1 times each draw list on the GPU (a fence
# wait after each), =2 only counts draws, indices and the guest frames a second; logs "rgds-stats" every 300 frames.
# Also logs the internal resolution the core reads. Apply on top of package patches 0001-0004 (2026-11-23), build with
# make flycast_libretro in the VM build tree. Used by os/device-bench/dc_run_*.sh as flycast_stats.so.

--- a/core/rend/gles/gldraw.cpp	2026-11-23 11:42:03.771256804 +0100
+++ b/core/rend/gles/gldraw.cpp	2026-11-23 11:42:03.772259957 +0100
@@ -11,6 +11,55 @@
 #include <algorithm>
 #include <cstring>
 #include <memory>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+
+// RG DS: RGDS_FLYCAST_STATS=1 times each list of each frame on the GPU (a fence wait between them, so the frame gets
+// slower, but each list's GPU work is attributed to it); =2 only counts draws and indices. Logs every 300 frames.
+enum { RS_SETUP, RS_OP, RS_PT, RS_MV, RS_TR, RS_POST, RS_RTT, RS_N };
+static int rs_mode = -1, rs_slot = RS_SETUP, rs_frames, rs_rtts, rs_passes, rs_w, rs_h;
+static bool rs_rtt;
+static double rs_us[RS_N], rs_last;
+static unsigned long long rs_draws[RS_N], rs_idx[RS_N];
+static double rs_now() { timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec * 1e6 + t.tv_nsec / 1e3; }
+void rgds_stats_mark(int slot)
+{
+	if (rs_mode < 0) { const char *e = getenv("RGDS_FLYCAST_STATS"); rs_mode = e ? atoi(e) : 0; }
+	if (!rs_mode) return;
+	if (rs_rtt) slot = RS_RTT;
+	if (rs_mode == 1) { void *f = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0); glClientWaitSync(f, GL_SYNC_FLUSH_COMMANDS_BIT, 1000000000ull); glDeleteSync(f); double t = rs_now(); rs_us[rs_slot] += t - rs_last; rs_last = t; }
+	rs_slot = slot;
+}
+static void rs_count(u32 count) { if (rs_mode > 0) { rs_draws[rs_slot]++; rs_idx[rs_slot] += count; } }
+void rgds_stats_begin(bool rtt, int w, int h)
+{
+	rgds_stats_mark(RS_SETUP);
+	if (!rs_mode) return;
+	rs_rtt = rtt; rs_slot = rtt ? RS_RTT : RS_SETUP; rs_last = rs_now();
+	if (rtt) rs_rtts++; else { rs_w = w; rs_h = h; }
+}
+void rgds_stats_end()
+{
+	if (!rs_mode) return;
+	rgds_stats_mark(RS_SETUP);
+	bool rtt = rs_rtt; rs_rtt = false; rs_slot = RS_SETUP;
+	if (rtt || ++rs_frames < 300) return;
+	static const char *names[RS_N] = { "setup", "opaque", "punch", "modvol", "transl", "post", "rtt" };
+	extern unsigned rgds_vblanks;
+	static double rs_t0; static unsigned rs_v0;
+	const double t1 = rs_now(); double rs_guest = 0, rs_shown = 0;
+	if (rs_t0 > 0) { rs_guest = (rgds_vblanks - rs_v0) / ((t1 - rs_t0) / 1e6); rs_shown = rs_frames / ((t1 - rs_t0) / 1e6); }
+	rs_t0 = t1; rs_v0 = rgds_vblanks;
+	char line[512]; int n = snprintf(line, sizeof(line), "rgds-stats res %d %dx%d guest %.1f/s shown %.1f/s per frame: passes %.1f rtt %.2f |", (int)config::RenderResolution, rs_w, rs_h, rs_guest, rs_shown,
+			(double)rs_passes / rs_frames, (double)rs_rtts / rs_frames);
+	for (int i = 0; i < RS_N; i++)
+		n += snprintf(line + n, sizeof(line) - n, " %s %.2fms %.0fd %.0fi", names[i], rs_us[i] / 1e3 / rs_frames,
+				(double)rs_draws[i] / rs_frames, (double)rs_idx[i] / rs_frames);
+	fprintf(stderr, "%s\n", line);
+	rs_frames = rs_rtts = rs_passes = 0;
+	for (int i = 0; i < RS_N; i++) rs_us[i] = 0, rs_draws[i] = rs_idx[i] = 0;
+}
 
