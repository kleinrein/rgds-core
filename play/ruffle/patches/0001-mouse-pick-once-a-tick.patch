+    pub fn may_have_child_named_on(&self) -> bool {
+        // "on", or anything a case-insensitive comparison might take for it.
+        let o_or_n = |c: u16, lower: u8| c == lower as u16 || c == (lower - 32) as u16 || c > 0x7F;
+        let on = |child: &DisplayObject<'gc>| {
+            child
+                .name()
+                .is_some_and(|n| n.len() >= 7 && o_or_n(n.at(0), b'o') && o_or_n(n.at(1), b'n'))
+        };
+        self.has_pending_removals
+            || self.render_list.iter().any(on)
+            || self.depth_list.values().any(on)
+    }
