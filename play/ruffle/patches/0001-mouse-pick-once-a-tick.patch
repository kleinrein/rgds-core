+                istr!("onDragOut"),
+                istr!("onPress"),
+                istr!("onRelease"),
+                istr!("onReleaseOutside"),
+                istr!("onRollOut"),
+                istr!("onRollOver"),
+            ];
+            debug_assert!(
+                handlers
+                    .iter()
+                    .zip(ClipEvent::BUTTON_EVENT_METHODS)
+                    .all(|(a, b)| a.to_utf8_lossy() == b)
