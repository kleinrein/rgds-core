+    /// RG DS: `has_property` for several names at once, for an object whose display object has no child or
+    /// `_property` by any of them (the caller's promise: `MovieClip::is_button_mode`). The object and its
+    /// prototype chain are walked once, each plain object on it asked for every name; anything else on the chain
+    /// (`super`, another clip) is asked the long way.
+    pub fn has_any_script_property(
+        self,
+        activation: &mut Activation<'_, 'gc>,
+        names: &[AvmString<'gc>],
+    ) -> bool {
+        let case_sensitive = activation.is_case_sensitive();
+        let mut object = self;
+        for depth in 0..256 {
+            let native = object.native_no_super();
+            let display_object = native.as_display_object();
+            if matches!(native, NativeObject::Super(_)) || (depth > 0 && display_object.is_some()) {
+                return names
+                    .iter()
+                    .any(|&name| object.has_property(activation, name));
+            }
+            // A removed clip has only its display object's properties, of which the caller says there are none.
+            if display_object.is_some_and(|o| o.avm1_removed()) {
+                return false;
+            }
+            let own = {
+                let data = object.0.borrow();
+                names
+                    .iter()
+                    .any(|&name| data.properties.contains_key(name, case_sensitive))
+            };
+            if own {
+                return true;
+            }
+            match object.proto(activation) {
+                Value::Object(proto) => object = proto,
+                _ => return false,
+            }
+        }
+        names
+            .iter()
+            .any(|&name| self.has_property(activation, name))
+    }
