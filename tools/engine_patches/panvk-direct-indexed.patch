+#include "panvk_device_memory.h"
+#include "util/u_debug.h"
+
+/* CPU pointer to the bound index range, or NULL when the direct path can't be used. */
+static const void *
+direct_index_ptr(struct panvk_cmd_buffer *cmdbuf, uint32_t first_index,
+                 uint32_t index_count)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = debug_get_bool_option("PANVK_DIRECT_INDEXED", false);
+   if (!enabled)
+      return NULL;
+
+   const struct panvk_buffer *buf = cmdbuf->state.gfx.ib.buf;
+   uint32_t isz = cmdbuf->state.gfx.ib.index_size;
+   if (!buf || !buf->mem || !buf->mem->addr.host || !isz)
+      return NULL;
+   if (((uint64_t)first_index + index_count) * isz > cmdbuf->state.gfx.ib.size)
+      return NULL;
+
+   return (const uint8_t *)buf->mem->addr.host + buf->mem_offset +
+          cmdbuf->state.gfx.ib.offset + (uint64_t)first_index * isz;
+}
+
+#define SCAN_MINMAX(T)                                                         \
+   do {                                                                        \
+      const T *p = ptr;                                                        \
+      T lo = (T)~(T)0, hi = 0;                                                 \
+      if (restart) {                                                           \
+         for (uint32_t i = 0; i < count; i++) {                                \
+            T v = p[i];                                                        \
+            if (v == (T)~(T)0)                                                 \
+               continue;                                                       \
+            lo = v < lo ? v : lo;                                              \
+            hi = v > hi ? v : hi;                                              \
+         }                                                                     \
+      } else {                                                                 \
+         for (uint32_t i = 0; i < count; i++) {                                \
+            T v = p[i];                                                        \
+            lo = v < lo ? v : lo;                                              \
+            hi = v > hi ? v : hi;                                              \
+         }                                                                     \
+      }                                                                        \
+      *min = lo;                                                               \
+      *max = hi;                                                               \
+   } while (0)
+
+/* False when every index is a restart index (nothing to draw). */
+static bool
+index_minmax(const void *ptr, uint32_t isz, uint32_t count, bool restart,
+             uint32_t *min, uint32_t *max)
+{
+   switch (isz) {
+   case 1: SCAN_MINMAX(uint8_t); break;
+   case 2: SCAN_MINMAX(uint16_t); break;
+   default: SCAN_MINMAX(uint32_t); break;
+   }
+   return *min <= *max;
+}
