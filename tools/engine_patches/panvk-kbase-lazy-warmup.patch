+static void
+kbase_wait_warmup(struct kbase_kmod_dev *kd)
+{
+   if (p_atomic_read(&kd->warmup_done))
+      return;
+   struct timespec now_ts;
+   clock_gettime(CLOCK_MONOTONIC, &now_ts);
+   const uint64_t now = (uint64_t)now_ts.tv_sec * 1000000000ull + (uint64_t)now_ts.tv_nsec;
+   if (now < kd->warmup_until_ns) {
+      const uint64_t left = kd->warmup_until_ns - now;
+      struct timespec rest = { .tv_sec = (time_t)(left / 1000000000ull), .tv_nsec = (long)(left % 1000000000ull) };
+      while (nanosleep(&rest, &rest) && errno == EINTR) {}
+   }
+   p_atomic_set(&kd->warmup_done, true);
+}
