+// A position/vector (mode 2) matrix write must invalidate the combined
+// projection/position cache even when an earlier vertex already populated it.
+// Mario Kart draws successive wheels with this path: a stale cache puts the
+// next wheel on top of the previous one in both software and Vulkan output.
+static void test_mode2_matrix_cache() {
+  const u32 commands[] = {0x16, 0x17, 0x18, 0x19, 0x1A, 0x1C};
+  for (u32 cmd : commands) {
+    NDS nds; power_on(nds);
+    w32(nds, CMD(0x10), 2);
+    w32(nds, CMD(0x15), 0);
+    auto position = [&] {
+      w32(nds, CMD(0x71), 0x10001000);
+      w32(nds, CMD(0x71), 0x1000);
+      advance(nds, 1000);
+    };
+    position();
+    CHECK_EQ(r32(nds, 0x04000620), 0x1000u); // populate identity cache
+    if (cmd == 0x1C) {
+      w32(nds, CMD(cmd), 0x1000); w32(nds, CMD(cmd), 0); w32(nds, CMD(cmd), 0);
+    } else {
+      const int rows = cmd == 0x16 || cmd == 0x18 ? 4 : 3;
+      const int columns = cmd == 0x1A ? 3 : 4;
+      for (int c = 0; c < columns; ++c) for (int r = 0; r < rows; ++r)
+        w32(nds, CMD(cmd), c == r ? (c == 0 ? 0x2000 : 0x1000) : 0);
+    }
+    position();
+    CHECK_EQ(r32(nds, 0x04000620), 0x2000u);
+    CHECK_EQ(r32(nds, 0x04000624), 0x1000u);
+    CHECK_EQ(r32(nds, 0x04000628), 0x1000u);
+    CHECK_EQ(r32(nds, 0x0400062C), 0x1000u);
+  }
+}
