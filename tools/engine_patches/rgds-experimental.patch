+// Capture is enabled in VBlank *after* the raster skip was scheduled. A
+// native framebuffer comparison alone misses this: compare captured VRAM.
+static void test_late_capture_after_raster_skip() {
+  std::vector<u8> expected;
+  for (bool skip : {false, true}) {
+    NDS n;
+    n.bus.dma_write16(Cpu::ARM9, 0x04000304, 0x820F);
+    n.bus.dma_write16(Cpu::ARM9, 0x04000240, 0x0080); // A is LCDC/capture target
+    n.bus.dma_write32(Cpu::ARM9, 0x04000350, 0x001F001F); // red, alpha31
+    n.gpu3d.vblank();
+    n.gpu.set_frameskip_capture(false);
+    n.gpu.set_frame_skip(skip);
+    run_display_frame(n, [](NDS&, u32, bool){});
+    // The deferred 3D frame must be ready when capture starts at line 0.
+    n.bus.dma_write32(Cpu::ARM9, 0x04000064, (1u<<31)|(1u<<24)|(3u<<20));
+    n.gpu.set_frame_skip(false);
+    run_display_frame(n, [](NDS&, u32, bool){});
+    const u8* v = n.bus.vram_bank(0);
+    if (!skip) {
+      expected.assign(v, v + 256*192*2);
+      CHECK_EQ(unsigned(v[0]) | (unsigned(v[1])<<8), 0x801Fu);
+    } else CHECK(std::memcmp(expected.data(), v, expected.size()) == 0);
+  }
+}
