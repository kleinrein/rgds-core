+// Keep the stopped system's timestamps unchanged, including scanline/DMA
+// phase and lazily sampled timers. Run only the independently clocked RTC
+// on a temporary timeline, then rebase its deadlines back onto system time.
+void Scheduler::run_sleep(u64 cycles) {
+  const u64 frozen = now_, limit = now_ + cycles;
+  constexpr u32 rtc_mask = (1u << static_cast<u32>(EventId::Rtc)) |
+                           (1u << static_cast<u32>(EventId::RtcClock));
+  while (nds_.sleeping && now_ < limit) {
+    u32 id = EVENT_COUNT;
+    u64 next = limit;
+    for (u32 m = armed_ & rtc_mask; m; m &= m - 1) {
+      const u32 i = static_cast<u32>(__builtin_ctz(m));
+      if (at_[i] <= next) { next = at_[i]; id = i; }
+    }
+    now_ = std::max(now_, next);
+    if (id == EVENT_COUNT) break;
+    armed_ &= ~(1u << id);
+    firing_at_ = at_[id];
+    fn_[id](nds_, param_[id]);
+  }
+  const u64 elapsed = now_ - frozen;
+  for (u32 m = armed_ & rtc_mask; m; m &= m - 1) {
+    const u32 i = static_cast<u32>(__builtin_ctz(m));
+    at_[i] -= elapsed;
+  }
+  if (nds_.io.rtc.ticking) nds_.io.rtc.next_tick -= elapsed;
+  now_ = frozen;
+  rescan();
+  nds_.spu.sleep_output(elapsed);
