+// Display-only four-sample resolve. DS alpha 0 means absent; present alpha
+// uses (a+1)/32. Average premultiplied colours so transparent edge texels
+// cannot produce dark fringes. Native guest pixels never use this filter.
+inline Pixel rgds_filter4(Pixel a, Pixel b, Pixel c, Pixel d) {
+  // Supersampling often lands inside one flat polygon or texture texel.
+  if (a == b && a == c && a == d) return (a >> 24) ? a : 0;
+  const u32 aa=a>>24, ab=b>>24, ac=c>>24, ad=d>>24;
+  if (aa==ab && aa==ac && aa==ad) {
+    if (!aa) return 0;
+    const u32 rb=(((a&0xFF00FF)+(b&0xFF00FF)+(c&0xFF00FF)+(d&0xFF00FF)+0x020002)>>2)&0xFF00FF;
+    const u32 g=(((a&0xFF00)+(b&0xFF00)+(c&0xFF00)+(d&0xFF00)+0x0200)>>2)&0xFF00;
+    return (aa<<24)|rb|g;
+  }
+  const u32 wa=aa?aa+1:0, wb=ab?ab+1:0, wc=ac?ac+1:0, wd=ad?ad+1:0;
