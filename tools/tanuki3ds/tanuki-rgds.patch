+#pragma once
+#include <cstring>
+
+namespace rgds {
+// Only sharp bilinear presets use the destination size to reconstruct pixels.
+inline constexpr bool shader_uses_target_size(int id) { return id == 1 || (id >= 9 && id <= 11); }
+// Append only: these IDs are persisted in per-game preferences.
+inline constexpr const char* shader_files[] = {"off",
+                                               "sharp_bilinear",
+                                               "lcd1x",
+                                               "zfast_lcd",
+                                               "nds_color",
+                                               "natural_vision",
+                                               "lcd1x+nds_color",
+                                               "lcd1x+natural_vision",
+                                               "lcd1x+nds_color+natural_vision",
+                                               "sharp_bilinear+nds_color",
+                                               "sharp_bilinear+natural_vision",
+                                               "sharp_bilinear+nds_color+natural_vision",
+                                               "zfast_lcd+nds_color",
+                                               "zfast_lcd+natural_vision",
+                                               "zfast_lcd+nds_color+natural_vision",
+                                               "soft_scanlines",
+                                               "warm_paper",
+                                               "cool_crisp",
+                                               "pocket_green",
+                                               "amber",
+                                               "soft_lcd_grid",
+                                               "ds_classic",
+                                               "ds_lite",
+                                               "natural_glow",
+                                               "vivid_lcd",
+                                               "natural_smooth",
+                                               "vivid_smooth",
+                                               "pixel_beads",
+                                               "glossy_tiles",
+                                               "gba_color",
+                                               "gba_screen",
+                                               "gb_screen",
+                                               "gbc_screen",
+                                               "gba_true_colour",
+                                               "gba_true_screen"};
+inline constexpr int shader_count = sizeof(shader_files) / sizeof(shader_files[0]);
+// The community lcd1x and zfast grids were tuned for 1080p, where one DS pixel
+// spans 5.6 display pixels. On the 640x480 panels it spans 2.5, so only every
+// fifth column and row lands on a grid line and the upstream attenuation terms
+// read as plain dimming. These strengths keep the lines clearly visible on the
+// handheld (about a quarter of the brightness on a flat image) while the mean
+// brightness stays above four fifths. Colour-only and RGDS presets ignore them.
+inline constexpr bool shader_uses_lcd1x_grid(int id) { return id == 2 || (id >= 6 && id <= 8); }
+inline constexpr bool shader_uses_zfast_grid(int id) { return id == 3 || (id >= 12 && id <= 14); }
+inline constexpr const char* shader_grid_defines(int id) {
+    return shader_uses_lcd1x_grid(id)   ? "#define BRIGHTEN_SCANLINES 24.0\n#define BRIGHTEN_LCD 6.0\n"
+           : shader_uses_zfast_grid(id) ? "#define BORDERMULT 16.0\n"
+                                        : "";
+}
+// Picker order, grouped from plain pixels through DS screens to pixel art.
+// Every preset appears exactly once; IDs keep their persisted meaning.
+// A family named "... screens" is one handheld's own screen (shader_system_screens).
+inline constexpr const char* shader_family_names[] = {"Original",  "DS screens", "GBA screens", "Natural",    "Vivid",
+                                                      "Pixel art", "Moods",      "GB screens",  "GBC screens"};
+inline constexpr int shader_family_count = sizeof(shader_family_names) / sizeof(shader_family_names[0]);
+struct ShaderPlace {
+    int id, family;
+};
+inline constexpr ShaderPlace shader_order[] = {
+    {0, 0},  {1, 0},  {21, 1}, {22, 1}, {4, 1},  {6, 1}, {9, 1},  {12, 1}, {8, 1},  {11, 1}, {14, 1}, {30, 2},
+    {34, 2}, {29, 2}, {33, 2}, {23, 3}, {25, 3}, {5, 3}, {7, 3},  {10, 3}, {13, 3}, {20, 3}, {15, 3}, {24, 4},
+    {26, 4}, {17, 4}, {27, 5}, {28, 5}, {2, 5},  {3, 5}, {16, 6}, {18, 6}, {19, 6}, {31, 7}, {32, 8}};
+// The family of a system's own screens ("nds", "gba", "gb", "gbc"), or -1.
+inline int shader_system_screens(const char* system) {
+    const char* systems[] = {"nds", "gba", "gb", "gbc"};
+    const int families[] = {1, 2, 7, 8};
+    for (int i = 0; i < 4; ++i)
+        if (std::strcmp(system, systems[i]) == 0) return families[i];
+    return -1;
+}
+// What a game of another system shows when its own choice is Default: that handheld's screen
+// (the GBA's colour and pixel gaps, the Game Boy's dot matrix, the Game Boy Color's faint grid).
+// DS games use the default from Settings (-1).
+inline int system_default_shader(const char* system) {
+    const char* systems[] = {"gba", "gb", "gbc"};
+    const int shaders[] = {30, 31, 32};
+    for (int i = 0; i < 3; ++i)
+        if (std::strcmp(system, systems[i]) == 0) return shaders[i];
+    return -1;
+}
+// What Default draws for a game of `system`: that handheld's own screen, or for a DS game the
+// library shader from Settings.
+inline int default_shader_for(const char* system, int library) {
+    const int own = system_default_shader(system);
+    return own >= 0 ? own : library;
+}
+static_assert(sizeof(shader_order) / sizeof(shader_order[0]) == shader_count, "Every shader needs one picker place");
+inline constexpr int shader_family(int id) {
+    for (auto place : shader_order)
+        if (place.id == id) return place.family;
+    return 0;
+}
+}
diff --git a/src/platform/volume_hud.hpp b/src/platform/volume_hud.hpp
new file mode 100644
index 0000000..ee138a7
--- /dev/null
+++ b/src/platform/volume_hud.hpp
@@ -0,0 +1,121 @@
+#pragma once
+#include "platform/hud_style.hpp"
+#include <algorithm>
+#include <cstdint>
+#include <string>
+
+namespace rgds {
+// Small CPU canvas shared by SDL and OpenGL presentation. Premultiplied RGBA
+// lets the same HUD render over games without creating a compositor window.
+inline void draw_volume_hud(unsigned char* pixels, int level) {
+    level = std::clamp(level, 0, 100);
+    if (hud::volume(pixels, level)) return;
+    auto pixel = [&](int x, int y, int r, int g, int b, int a = 255) {
+        y += 56; // Below the RG DS performance counter.
+        auto* p = pixels + (y * 640 + x) * 4;
+        int inverse = 255 - a;
+        p[0] = (r * a + p[0] * inverse + 127) / 255;
+        p[1] = (g * a + p[1] * inverse + 127) / 255;
+        p[2] = (b * a + p[2] * inverse + 127) / 255;
+        p[3] = a + (p[3] * inverse + 127) / 255;
+    };
+    auto box = [&](int x, int y, int w, int h, int r, int g, int b, int a = 255) {
+        for (int yy = y; yy < y + h; yy++)
+            for (int xx = x; xx < x + w; xx++) pixel(xx, yy, r, g, b, a);
+    };
+    // RG DS Core palette: matte navy, quiet border and blue accent.
+    for (int y = 48; y < 130; y++)
+        for (int x = 108; x < 532; x++) {
+            int dx = std::max({116 - x, 0, x - 523}), dy = std::max({56 - y, 0, y - 121});
+            if (dx * dx + dy * dy > 64) continue;
+            bool border = x == 108 || x == 531 || y == 48 || y == 129 || dx * dx + dy * dy > 49;
+            int shade = 23;
+            pixel(x, y, border ? 45 : shade, border ? 67 : 32, border ? 90 : 46, 245);
+        }
+    auto glyph = [](char c) -> uint64_t {
+        switch (c) {
+        case '0': return 0x1f11111111111full;
+        case '1': return 0x040c040404040eull;
+        case '2': return 0x1e01011e10101full;
+        case '3': return 0x1e01010e01011eull;
+        case '4': return 0x1111111f010101ull;
+        case '5': return 0x1f10101e01011eull;
+        case '6': return 0x0f10101e11111full;
+        case '7': return 0x1f010204080808ull;
+        case '8': return 0x1f11111f11111full;
+        case '9': return 0x1f11111f01011eull;
+        case '%': return 0x19190204081313ull;
+        case 'V': return 0x11111111110a04ull;
+        case 'O': return 0x0e11111111110eull;
+        case 'L': return 0x1010101010101full;
+        case 'U': return 0x1111111111110eull;
+        case 'M': return 0x111b1515111111ull;
+        case 'E': return 0x1f10101e10101full;
+        case 'T': return 0x1f040404040404ull;
+        case 'D': return 0x1e11111111111eull;
+        default: return 0;
+        }
+    };
+    auto text = [&](const std::string& value, int x, int y, int scale) {
+        for (char c : value) {
+            uint64_t bits = glyph(c);
+            for (int row = 0; row < 7; row++)
+                for (int col = 0; col < 5; col++)
+                    if ((bits >> ((6 - row) * 8)) & (1 << (4 - col)))
+                        box(x + col * scale, y + row * scale, scale, scale, 233, 244, 255);
+            x += 6 * scale;
+        }
+    };
+    box(128, 74, 10, 17, 43, 113, 168);
+    for (int x = 138; x < 151; x++) {
+        int spread = (x - 138) * 3 / 4;
+        box(x, 74 - spread, 1, 17 + spread * 2, 43, 113, 168);
+    }
+    if (level) {
+        for (int y = 73; y < 92; y++)
+            for (int x = 159; x < 172; x++) {
+                int dx = x - 151, dy = y - 82, d = dx * dx + dy * dy;
+                if ((d >= 110 && d <= 155) || (d >= 300 && d <= 360)) pixel(x, y, 43, 113, 168);
+            }
+    } else {
+        for (int i = 0; i < 24; i++) {
+            pixel(129 + i, 69 + i, 167, 73, 83);
+            pixel(130 + i, 69 + i, 167, 73, 83);
+        }
+    }
+    text(level ? "VOLUME" : "MUTED", 190, 68, 3);
+    std::string percent = std::to_string(level) + "%";
+    text(percent, 510 - int(percent.size()) * 18, 68, 3);
+    box(128, 106, 384, 10, 45, 67, 90);
+    int fill = 384 * level / 100;
+    for (int y = 106; y < 116; y++) box(128, y, fill, 1, 78, 187, 255);
+    if (fill) box(128, 106, fill, 2, 135, 213, 255);
+}
+// The bridge owns FF status as well as volume, so the two backends of our
+// emulator never expose a second native on-screen display.
+inline void draw_fast_forward_hud(unsigned char* pixels) {
+    if (hud::fast_forward(pixels)) return;
+    auto put = [&](int x, int y, int r, int g, int b, int a = 245) {
+        auto* p = pixels + (y * 640 + x) * 4;
+        p[0] = (r * a + 127) / 255;
+        p[1] = (g * a + 127) / 255;
+        p[2] = (b * a + 127) / 255;
+        p[3] = a;
+    };
+    for (int y = 420; y < 458; ++y)
+        for (int x = 24; x < 142; ++x) {
+            int dx = std::max({30 - x, 0, x - 135}), dy = std::max({426 - y, 0, y - 451});
+            if (dx * dx + dy * dy > 36) continue;
+            bool edge = dx * dx + dy * dy > 25 || x == 24 || x == 141 || y == 420 || y == 457;
+            put(x, y, edge ? 45 : 23, edge ? 67 : 32, edge ? 90 : 46);
+        }
+    for (int n = 0; n < 2; ++n)
+        for (int x = 0; x < 12; ++x)
+            for (int y = -10 + x; y <= 10 - x; ++y) put(40 + n * 14 + x, 439 + y, 78, 187, 255, 255);
+    // Two F glyphs, matching the menu's pixel labels.
+    for (int n = 0; n < 2; ++n)
+        for (int y = 0; y < 21; ++y)
+            for (int x = 0; x < 15; ++x)
+                if (x < 3 || y < 3 || (y >= 9 && y < 12 && x < 12)) put(87 + n * 21 + x, 429 + y, 233, 244, 255, 255);
+}
+}
