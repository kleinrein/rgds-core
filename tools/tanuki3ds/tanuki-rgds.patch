diff --git a/src/rgds_hud.cpp b/src/rgds_hud.cpp
new file mode 100644
index 0000000..4cf2540
--- /dev/null
+++ b/src/rgds_hud.cpp
@@ -0,0 +1,148 @@
+// The volume bar, fast-forward badge and FPS counter as RG DS Core draws them for
+// every engine. The headers in platform/ are copies of src/platform/ in the RG DS repo.
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+#include "platform/frame_stats.hpp"
+#include "platform/shader_catalog.hpp"
+#include "platform/volume_hud.hpp"
+
+extern "C" void rgds_hud_draw(unsigned char* pixels, int volume, bool fast_forward, double fps) {
+    std::memset(pixels, 0, 640 * 480 * 4);
+    if (volume >= 0) rgds::draw_volume_hud(pixels, volume);
+    if (fast_forward) rgds::draw_fast_forward_hud(pixels);
+    if (fps >= 0) rgds::draw_fps_hud(pixels, fps, false);
+}
+
+extern "C" const char* rgds_shader_file(int id) {
+    return id > 0 && id < rgds::shader_count ? rgds::shader_files[id] : nullptr;
+}
+
+extern "C" const char* rgds_shader_defines(int id) {
+    return rgds::shader_grid_defines(id);
+}
+
+extern "C" bool rgds_shader_uses_target(int id) {
+    return rgds::shader_uses_target_size(id);
+}
+
+// The 3DS lid around its top screen, in the strips the screen leaves on a 4:3 panel. Shapes only,
+// as RG DS Core's other bezels (play/src/ui/frame_styles.hpp keeps the same slugs and names).
+namespace {
+struct Lid {
+    const char* slug;
+    unsigned top, bottom, glass, rim;
+};
+constexpr Lid lids[] = {
+    {"ctr-dark", 0x15161A, 0x0F1013, 0x0F1013, 0x15161A},
+    {"ctr-cosmos", 0x34373D, 0x1E2024, 0x08090B, 0x4A4E56},
+    {"ctr-aqua", 0x4FB6D6, 0x2F8FB0, 0x08090B, 0x7FD0E8},
+    {"ctr-flame", 0xD0303A, 0xA01C26, 0x08090B, 0xE8606A},
+    {"ctr-pink", 0xF6C6D4, 0xE6A4B8, 0x120C0E, 0xFBDDE6},
+    {"ctr-white", 0xF2F2EF, 0xD8D8D4, 0xE9E9E6, 0xFFFFFF},
+    {"ctr-midnight", 0x4E3A78, 0x322450, 0x08090B, 0x6E58A0},
+};
+
+struct Paint {
+    unsigned char* px;
+    void set(int x, int y, unsigned rgb, float a = 1) {
+        if (x < 0 || x >= 640 || y < 0 || y >= 480 || a <= 0) return;
+        auto* p = px + (y * 640 + x) * 4;
+        for (int i = 0; i < 3; i++) {
+            float v = (rgb >> (16 - 8 * i)) & 255;
+            p[i] = (unsigned char) (v * a + p[i] * (1 - a) + 0.5f);
+        }
+        p[3] = 255;
+    }
+    void box(int x, int y, int w, int h, unsigned rgb, float a = 1) {
+        for (int yy = y; yy < y + h; yy++)
+            for (int xx = x; xx < x + w; xx++) set(xx, yy, rgb, a);
+    }
+    void disc(float cx, float cy, float r, unsigned rgb, float a = 1) {
+        for (int y = int(cy - r - 1); y <= int(cy + r + 1); y++)
+            for (int x = int(cx - r - 1); x <= int(cx + r + 1); x++) {
+                float dx = x + 0.5f - cx, dy = y + 0.5f - cy, d = std::sqrt(dx * dx + dy * dy);
+                set(x, y, rgb, a * std::clamp(r - d + 0.5f, 0.f, 1.f));
+            }
+    }
+};
+
+unsigned blend(unsigned a, unsigned b, float t) {
+    unsigned out = 0;
+    for (int shift = 16; shift >= 0; shift -= 8) {
+        float x = (a >> shift) & 255, y = (b >> shift) & 255;
+        out |= unsigned(x + (y - x) * t + 0.5f) << shift;
+    }
+    return out;
+}
+}
+
+extern "C" bool rgds_bezel_known(const char* slug) {
+    for (auto& lid : lids)
+        if (!std::strcmp(lid.slug, slug)) return true;
+    return false;
+}
+
+// (sx, sy, sw, sh): where the game's picture lies. A whole panel of opaque pixels, first row at the top.
+extern "C" void rgds_bezel_draw(unsigned char* pixels, const char* slug, int sx, int sy, int sw, int sh) {
+    const Lid* lid = &lids[0];
+    for (auto& l : lids)
+        if (!std::strcmp(l.slug, slug)) lid = &l;
+    std::memset(pixels, 255, 640 * 480 * 4);
+    Paint p{pixels};
+    // Clean dark: nothing but a quiet ground and a hairline around the picture
+    if (!std::strcmp(lid->slug, "ctr-dark")) {
+        for (int y = 0; y < 480; y++) p.box(0, y, 640, 1, blend(lid->top, lid->bottom, y / 479.f));
+        p.box(sx - (sw < 640), sy - 1, sw + 2 * (sw < 640), sh + 2, 0x25272C);
+        p.box(sx, sy, sw, sh, 0);
+        return;
+    }
+    // the lid, lit from above
+    for (int y = 0; y < 480; y++) p.box(0, y, 640, 1, blend(lid->top, lid->bottom, y / 479.f));
+    p.box(0, 0, 640, 2, lid->rim);
+
+    // the glass over the screen, as far as the lid's edge and the hinge leave room
+    const int edge = 10, hinge = 26;
+    int gx = sw >= 640 ? 0 : edge, gw = sw >= 640 ? 640 : 640 - edge * 2;
+    int gy = edge, gh = 480 - edge - hinge;
+    p.box(gx, gy, gw, gh, lid->glass);
+    const bool pale = ((lid->glass >> 16) & 255) > 128;
+    p.box(gx, gy, gw, 1, blend(lid->glass, pale ? 0x000000 : 0xFFFFFF, 0.16f));
+    // a soft sheen across the glass above the picture
+    for (int y = gy + 1; y < sy; y++) {
+        float t = float(y - gy) / std::max(1, sy - gy);
+        p.box(gx, y, gw, 1, pale ? 0x000000 : 0xFFFFFF, (pale ? 0.05f : 0.07f) * (1 - t));
+    }
+
+    const int mid = (gy + sy) / 2;
+    // the camera over the screen
+    p.disc(320, mid, 8.5f, blend(lid->glass, pale ? 0x808080 : 0x505660, 0.8f));
+    p.disc(320, mid, 6.5f, 0x05060A);
+    p.disc(320, mid, 3.5f, 0x141C34);
+    p.disc(318.2f, mid - 1.8f, 1.3f, 0xB0C0E0, 0.9f);
+    // the 3D light beside it
+    p.disc(372, mid, 2.5f, pale ? 0xA8A8A8 : 0x2A2C30);
+    // speaker holes at both ends
+    const unsigned hole = pale ? 0x8A8A88 : 0x34363C;
+    for (int side = 0; side < 2; side++)
+        for (int row = -1; row <= 1; row++)
+            for (int col = 0; col < 7; col++) {
+                int x = (side ? 640 - 58 : 30) + col * 4 + ((row & 1) ? 2 : 0);
+                p.disc(x + 0.5f, mid + row * 5.0f, 1.2f, hole);
+            }
+
+    // a thin frame where the glass meets the picture
+    if (sw < 640) p.box(sx - 2, sy - 2, sw + 4, sh + 4, pale ? 0xB4B4B0 : 0x24262A);
+    p.box(sx, sy, sw, sh, 0);
+
+    // the hinge along the bottom, its two barrels
+    const int hy = 480 - hinge;
+    p.box(0, hy, 640, 2, blend(lid->bottom, 0x000000, 0.35f));
+    p.box(0, hy + 2, 640, 1, blend(lid->rim, lid->top, 0.3f));
+    for (int side = 0; side < 2; side++) {
+        int x = side ? 640 - 150 : 40;
+        p.box(x, hy + 7, 110, 12, blend(lid->bottom, 0x000000, 0.28f));
+        p.box(x, hy + 7, 110, 1, blend(lid->rim, lid->bottom, 0.4f));
+    }
+}
diff --git a/src/savestate.c b/src/savestate.c
new file mode 100644
index 0000000..b102eba
--- /dev/null
+++ b/src/savestate.c
@@ -0,0 +1,292 @@
+// A whole-machine save state. Kernel objects keep their pointers (kernel/karena.c
+// at a fixed address, the E3DS struct in a static of a binary that is not position
+// independent), which also ties a state to the exact binary that wrote it; the
+// game's own save data is not in here and does not depend on this.
+#include "savestate.h"
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <xxh3.h>
+#include <zstd.h>
+
+#include "arm/jit/jit.h"
+#include "emulator.h"
+#include "kernel/karena.h"
+#include "kernel/memory.h"
+#include "kernel/svc_types.h"
+
+#define SS_VERSION 1
+
+typedef struct {
+    char magic[8];
+    u32 version;
+    u32 e3ds_size;
+    u64 build;
+    u64 rom;
+} SSHeader;
+
+typedef struct {
+    FILE* f;
+    ZSTD_CCtx* c;
+    ZSTD_DCtx* d;
+    u8* buf;
+    size_t cap;
+    ZSTD_inBuffer in;
+    bool err;
+} SS;
+
+static void ss_put(SS* ss, const void* p, size_t n, ZSTD_EndDirective mode) {
+    ZSTD_inBuffer in = {p, n, 0};
+    size_t left;
+    do {
+        ZSTD_outBuffer out = {ss->buf, ss->cap, 0};
+        left = ZSTD_compressStream2(ss->c, &out, &in, mode);
+        if (ZSTD_isError(left)) {
+            ss->err = true;
+            return;
+        }
+        if (out.pos && fwrite(ss->buf, 1, out.pos, ss->f) != out.pos) {
+            ss->err = true;
+            return;
+        }
+    } while (mode == ZSTD_e_end ? left != 0 : in.pos < in.size);
+}
+
+void savestate_put(void* ss, const void* p, size_t n) {
+    ss_put(ss, p, n, ZSTD_e_continue);
+}
+
+bool savestate_get(void* ctx, void* p, size_t n) {
+    SS* ss = ctx;
+    ZSTD_outBuffer out = {p, n, 0};
+    while (out.pos < out.size) {
+        if (ss->in.pos == ss->in.size) {
+            ss->in.size = fread(ss->buf, 1, ss->cap, ss->f);
+            ss->in.pos = 0;
+            if (!ss->in.size) {
+                ss->err = true;
+                return false;
+            }
+        }
+        size_t r = ZSTD_decompressStream(ss->d, &out, &ss->in);
+        if (ZSTD_isError(r)) {
+            ss->err = true;
+            return false;
+        }
+    }
+    return true;
+}
+
+static u64 ss_build() {
+    static u64 build;
+    if (build) return build;
+    int fd = open("/proc/self/exe", O_RDONLY);
+    struct stat st;
+    if (fd >= 0 && !fstat(fd, &st)) {
+        void* m = mmap(nullptr, st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
+        if (m != MAP_FAILED) {
+            build = XXH3_64bits(m, st.st_size);
+            munmap(m, st.st_size);
+        }
+    }
+    if (fd >= 0) close(fd);
+    return build;
+}
+
+static void ss_header(SSHeader* h) {
+    memset(h, 0, sizeof *h);
+    memcpy(h->magic, "T3DSSTAT", 8);
+    h->version = SS_VERSION;
+    h->e3ds_size = sizeof(E3DS);
+    h->build = ss_build();
+    h->rom = XXH3_64bits(ctremu.romfilenoext, strlen(ctremu.romfilenoext));
+}
+
+void* savestate_capture(u64* size) {
+    extern void* gpu_gl_fbs_capture(GPU*, u64*);
+    return gpu_gl_fbs_capture(&ctremu.system.gpu, size);
+}
+
+bool savestate_write(const char* path, const void* blob, u64 blob_size) {
+    E3DS* s = &ctremu.system;
+    SS ss = {};
+    ss.f = fopen(path, "wb");
+    if (!ss.f) return false;
+    ss.cap = 1 << 20;
+    ss.buf = malloc(ss.cap);
+    ss.c = ZSTD_createCCtx();
+    ZSTD_CCtx_setParameter(ss.c, ZSTD_c_compressionLevel, 1);
+    ZSTD_CCtx_setParameter(ss.c, ZSTD_c_checksumFlag, 1);
+    ZSTD_CCtx_setParameter(ss.c, ZSTD_c_nbWorkers, 2);
+
+    SSHeader h;
+    ss_header(&h);
+    bool ok = fwrite(&h, sizeof h, 1, ss.f) == 1;
+
+    if (ok) {
+        extern void fs_files_put(E3DS*, void*);
+        savestate_put(&ss, s, sizeof *s);
+        u64 used = ka_used();
+        savestate_put(&ss, &used, sizeof used);
+        savestate_put(&ss, ka_base(), used);
+        savestate_put(&ss, &s->physmem[FCRAM_PBASE], FCRAM_SIZE);
+        savestate_put(&ss, &s->physmem[VRAM_PBASE], VRAM_SIZE);
+        savestate_put(&ss, &s->physmem[DSPRAM_PBASE], DSPRAM_SIZE);
+        fs_files_put(s, &ss);
+        savestate_put(&ss, &blob_size, sizeof blob_size);
+        savestate_put(&ss, blob, blob_size);
+        ss_put(&ss, nullptr, 0, ZSTD_e_end);
+    }
+    ok = ok && !ss.err && !fflush(ss.f) && !fsync(fileno(ss.f));
+    if (fclose(ss.f)) ok = false;
+    ZSTD_freeCCtx(ss.c);
+    free(ss.buf);
+    return ok;
+}
+
+static void ss_map_virtual(E3DS* s) {
+    void* r = mmap(s->virtmem, BITL(32), PROT_NONE,
+                   MAP_PRIVATE | MAP_ANON | MAP_NORESERVE | MAP_FIXED, -1, 0);
+    if (r == MAP_FAILED) {
+        perror("mmap");
+        exit(1);
+    }
+    extern u32 physaddr2memoff(u32 paddr);
+    u32 runv = 0, runp = 0, n = 0;
+    for (u32 l1 = 0; l1 < BIT(10); l1++) {
+        PageEntry* t = s->process.ptab[l1];
+        for (u32 l2 = 0; l2 < BIT(10); l2++) {
+            bool used = t && t[l2].state != MEMST_FREE;
+            u32 v = l1 << 22 | l2 << 12;
+            if (n && (!used || t[l2].paddr != runp + n * PAGE_SIZE ||
+                      physaddr2memoff(t[l2].paddr) != physaddr2memoff(runp) + n * PAGE_SIZE)) {
+                if (mmap(&s->virtmem[runv], n * PAGE_SIZE, PROT_READ | PROT_WRITE,
+                         MAP_SHARED | MAP_FIXED, s->mem_fd, physaddr2memoff(runp)) == MAP_FAILED) {
+                    perror("mmap");
+                    exit(1);
+                }
+                n = 0;
+            }
+            if (used) {
+                if (!n) {
+                    runv = v;
+                    runp = t[l2].paddr;
+                }
+                n++;
+            }
+        }
+    }
+    if (n && mmap(&s->virtmem[runv], n * PAGE_SIZE, PROT_READ | PROT_WRITE,
+                  MAP_SHARED | MAP_FIXED, s->mem_fd, physaddr2memoff(runp)) == MAP_FAILED) {
+        perror("mmap");
+        exit(1);
+    }
+}
+
+struct SSLoaded {
+    GPU* gpu;
+    u8* blob;
+};
+
+// Everything but the renderer's side, which savestate_read_finish takes on the thread with the
+// GL context. Nothing else may touch the machine meanwhile.
+SSLoaded* savestate_read(const char* path, bool* wrecked) {
+    E3DS* s = &ctremu.system;
+    *wrecked = false;
+    SS ss = {};
+    ss.f = fopen(path, "rb");
+    if (!ss.f) return nullptr;
+    SSHeader h, want;
+    ss_header(&want);
+    if (fread(&h, sizeof h, 1, ss.f) != 1 || memcmp(&h, &want, sizeof h)) {
+        fprintf(stderr, "spike state %s is not for this game and build\n", path);
+        fclose(ss.f);
+        return nullptr;
+    }
+    ss.cap = 1 << 20;
+    ss.buf = malloc(ss.cap);
+    ss.d = ZSTD_createDCtx();
+    ss.in.src = ss.buf;
+
+    SSLoaded* out = nullptr;
+    E3DS* t = aligned_alloc(4096, (sizeof *t + 4095) & ~(size_t) 4095);
+    u64 used = 0;
+    bool ok = savestate_get(&ss, t, sizeof *t) && savestate_get(&ss, &used, sizeof used);
+    if (!ok) goto end; // nothing has changed yet
+
+    // from here on the machine is being replaced
+    *wrecked = true;
+    {
+        extern void fs_files_close(E3DS*);
+        extern void fs_files_get(E3DS*, void*);
+        extern void jit_state_loaded(ArmCore*);
+
+        fs_files_close(s);
+        ok = savestate_get(&ss, ka_base(), used);
+        ok = ok && savestate_get(&ss, &s->physmem[FCRAM_PBASE], FCRAM_SIZE);
+        ok = ok && savestate_get(&ss, &s->physmem[VRAM_PBASE], VRAM_SIZE);
+        ok = ok && savestate_get(&ss, &s->physmem[DSPRAM_PBASE], DSPRAM_SIZE);
+        if (!ok) goto end;
+
+        jit_state_loaded(&s->cpu);
+
+        // what belongs to this process stays as it is
+        t->cpu.fastmem = s->cpu.fastmem;
+        memcpy(t->cpu.jit_cache, s->cpu.jit_cache, sizeof t->cpu.jit_cache);
+        t->mem = s->mem;
+        t->mem_fd = s->mem_fd;
+        t->physmem = s->physmem;
+        t->virtmem = s->virtmem;
+        t->romimage.fp = s->romimage.fp;
+        t->dsp.mem = s->dsp.mem;
+        t->dsp.aac_handle = s->dsp.aac_handle;
+        memset(t->services.fs.files, 0, sizeof t->services.fs.files);
+        memset(t->services.fs.dirs, 0, sizeof t->services.fs.dirs);
+
+        // the renderer goes on presenting from its own struct: all around it now, the guest's
+        // side of it on the GL thread at the end
+        out = calloc(1, sizeof *out);
+        out->gpu = malloc(sizeof(GPU));
+        memcpy(out->gpu, &t->gpu, sizeof(GPU));
+        size_t before = offsetof(E3DS, gpu), after = before + sizeof(GPU);
+        memcpy(s, t, before);
+        memcpy((char*) s + after, (char*) t + after, sizeof *s - after);
+
+        ss_map_virtual(s);
+        fs_files_get(s, &ss);
+        u64 blob_size = 0;
+        ok = savestate_get(&ss, &blob_size, sizeof blob_size) && blob_size < (1ull << 30);
+        if (ok) {
+            out->blob = malloc(blob_size);
+            ok = savestate_get(&ss, out->blob, blob_size);
+        }
+        if (!ok) goto end;
+        *wrecked = false;
+    }
+
+end:
+    free(t);
+    ZSTD_freeDCtx(ss.d);
+    free(ss.buf);
+    fclose(ss.f);
+    if (!ok && out) {
+        free(out->gpu);
+        free(out->blob);
+        free(out);
+        out = nullptr;
+    }
+    return out;
+}
+
+void savestate_read_finish(SSLoaded* loaded) {
+    extern void gpu_gl_state_loaded(GPU*, GPU*, const u8*);
+    gpu_gl_state_loaded(&ctremu.system.gpu, loaded->gpu, loaded->blob);
+    free(loaded->gpu);
+    free(loaded->blob);
+    free(loaded);
+}
