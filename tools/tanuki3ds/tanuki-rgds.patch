+                                              ctremu.videoscale * 4;
+    }
+    u8* blob = malloc(total);
+    u8* p = blob;
+    memcpy(p, &count, sizeof count);
+    p += sizeof count;
+    u64 cur = gpu->curfb ? gpu->curfb->color_paddr : 0;
